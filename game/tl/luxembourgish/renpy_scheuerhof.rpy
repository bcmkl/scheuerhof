# game/renpy_scheuerhof.rpy:189
translate luxembourgish start_474d7b4f:

    # "Später Sommerabend am Sportplatz von Nohn. Die Luft ist noch warm, das Gras riecht nach Staub und Grillkohle."
    "Spéiden Summerowend um Sportsterrain vun Nohn. D'Loft ass nach waarm, d'Gras richt no Stëbs a Grillkuel."

# game/renpy_scheuerhof.rpy:191
translate luxembourgish start_dd904e37:

    # "Lina, Kai und Mira sitzen am Lagerfeuer, so wie an den meisten Freitagen seit der neunten Klasse."
    "Lina, Kai a Mira sëtzen um Lagerfeier, sou wéi bal all Freideg zënter der néngter Klass."

# game/renpy_scheuerhof.rpy:194
translate luxembourgish start_6dd4a1cc:

    # k "Alles an mir sieht komisch aus, Mira. Verschwendete Mühe."
    k "Alles un mir gesäit komesch aus, Mira. Verschwend Méi."

# game/renpy_scheuerhof.rpy:195
translate luxembourgish start_8333a059:

    # l "Stimmt nicht. Im Halbdunkel bist du fast erträglich."
    l "Stëmmt net. Am Hallefdonkel bass du bal erdréiglech."

# game/renpy_scheuerhof.rpy:196
translate luxembourgish start_0176b107:

    # k "Danke. Sehr aufbauend."
    k "Merci. Ganz opbauend."

# game/renpy_scheuerhof.rpy:198
translate luxembourgish start_bf47fe34:

    # "Mira dreht die Kamera zu Lina. Lina hält die Hand davor."
    "Mira dréint d'Kamera op Lina. Lina hält d'Hand virdrun."

# game/renpy_scheuerhof.rpy:200
translate luxembourgish start_4904f4cb:

    # l "Nicht mich. Ich seh heute nicht gut aus."
    l "Net mech. Ech gesinn haut net gutt aus."

# game/renpy_scheuerhof.rpy:201
translate luxembourgish start_d7610448:

    # m "Du siehst nie schlecht aus. Du versteckst dich nur gern."
    m "Du gesäis ni schlecht aus. Du verstecks dech just gär."

# game/renpy_scheuerhof.rpy:203
translate luxembourgish start_d3536616:

    # "Ein kurzer Blick zwischen den beiden. Nichts Großes. Aber genug, dass es Kai auffällt."
    "E kuerze Bléck tëscht deenen zwee. Näischt Grousses. Awer genuch, dass et de Kai opfält."

# game/renpy_scheuerhof.rpy:205
translate luxembourgish start_1c6877fd:

    # k "Seit wann sammelst du eigentlich Fotos von uns wie Beweisstücke?"
    k "Zënter wéini sammels du Fotoen vun eis wéi Beweisstécker?"

# game/renpy_scheuerhof.rpy:206
translate luxembourgish start_a25966c2:

    # m "Seit mir aufgefallen ist, dass sich keiner von euch an irgendwas erinnert, wenn ich's nicht festhalte."
    m "Zënter mir opgefall ass, dass keen vun iech sech un eppes erënnert, wann ech et net festhalen."

# game/renpy_scheuerhof.rpy:208
translate luxembourgish start_6261e041:

    # "Irgendwo bellt ein Hund. Zwei Straßen weiter lacht jemand zu laut über einen Lautsprecher. Ein ganz gewöhnlicher Abend."
    "Iergendwou bellt e Hond. Zwou Strooss weider laacht ee ze haart iwwer e Lautsprecher. E ganz gewéinlechen Owend."

# game/renpy_scheuerhof.rpy:210
translate luxembourgish start_fffb6124:

    # k "Wisst ihr noch, letztes Jahr, als Basti hier eingepennt ist und wir ihm mit Kreide 'ich liebe Montage' auf die Stirn geschrieben haben?"
    k "Wësst dir nach, lescht Joer, wéi de Basti hei ageschlof ass, a mir him mat Kräid 'ech gär de Méindeg' op d'Stir geschriwwen hunn?"

# game/renpy_scheuerhof.rpy:211
translate luxembourgish start_724716f2:

    # l "Das war episch."
    l "Dat war epesch."

# game/renpy_scheuerhof.rpy:212
translate luxembourgish start_681107a0:

    # m "Das war fies. Ich hab natürlich Fotos."
    m "Dat war gemeng. Ech hu natierlech Fotoen."

# game/renpy_scheuerhof.rpy:214
translate luxembourgish start_6e5a9cbd:

    # "Sie lachen. Für ein paar Sekunden ist es einfach nur ein guter Abend."
    "Si laachen. Fir e puer Sekonnen ass et einfach nëmmen e gudden Owend."

# game/renpy_scheuerhof.rpy:216
translate luxembourgish start_e00d533c:

    # "Dann knistert das Feuer unruhig auf. Für einen Moment wirken die Schatten der drei etwas länger, als sie sein sollten."
    "Da knistert d'Feier onroueg op. Fir e Moment wierken d'Schiedele vun den dräi liicht méi laang, wéi se sollte sinn."

# game/renpy_scheuerhof.rpy:218
translate luxembourgish start_894da066:

    # l "Das Feuer klingt… anders. Als würde es zuhören."
    l "D'Feier kléngt… anescht. Wéi wann et nolauschtert."

# game/renpy_scheuerhof.rpy:219
translate luxembourgish start_1022c134:

    # k "Du klingst wie mein Opa, wenn er über den Scheuerhof geredet hat."
    k "Du klénks wéi mäi Bopa, wann hie vum Scheuerhof geschwat huet."

# game/renpy_scheuerhof.rpy:221
translate luxembourgish start_73ec7b95:

    # "Kai lacht kurz auf. Es klingt nicht ganz echt."
    "De Kai laacht kuerz op. Et kléngt net ganz echt."

# game/renpy_scheuerhof.rpy:223
translate luxembourgish start_c21a2436:

    # k "Ist im Winter gestorben. Falls ich das noch nicht erwähnt hab."
    k "Ass am Wanter gestuerwen. Falls ech dat nach net erwähnt hunn."

# game/renpy_scheuerhof.rpy:224
translate luxembourgish start_cb059ac9:

    # m "Kai…"
    m "Kai…"

# game/renpy_scheuerhof.rpy:225
translate luxembourgish start_8edcec65:

    # k "Passt schon. Du konntest ja nicht fragen, wenn ich's nie gesagt hab."
    k "Passt schonn. Du konnts jo net froen, wann ech et ni gesot hunn."

# game/renpy_scheuerhof.rpy:227
translate luxembourgish start_c0211929:

    # "Er wirft ein Stück Holz ins Feuer. Etwas zu hart. Funken stieben hoch."
    "Hie geheit e Stéck Holz an d'Feier. E bësse ze haart. Funken sprëtzen op."

# game/renpy_scheuerhof.rpy:229
translate luxembourgish start_d5f7c3be:

    # k "Bis zum Schluss hat er vom Scheuerhof geredet. Ich dachte, es wären die Medikamente. Jetzt bin ich nicht mehr sicher."
    k "Bis zum Schluss huet hie vum Scheuerhof geschwat. Ech hunn geduecht, et wären d'Medikamenter. Elo sinn ech mir net méi sécher."

# game/renpy_scheuerhof.rpy:231
translate luxembourgish start_a41c8655:

    # m "Ich mach ein Foto. Vielleicht sieht man etwas, das wir nicht sehen."
    m "Ech maachen e Foto. Vläicht gesäit een eppes, wat mir net gesinn."

# game/renpy_scheuerhof.rpy:239
translate luxembourgish start_89a9f13c:

    # l "Seit Tagen höre ich ein Flüstern. Nicht laut. Eher wie ein Gedanke, der nicht meiner ist."
    l "Zënter Deeg héieren ech e Flüsteren. Net haart. Éischter wéi e Gedanken, deen net mengen ass."

# game/renpy_scheuerhof.rpy:241
translate luxembourgish start_383b1ff7:

    # l "Schon gut. Ich bin nur müde."
    l "Schonn gutt. Ech sinn nëmmen midd."

# game/renpy_scheuerhof.rpy:243
translate luxembourgish start_5b35fbf4:

    # k "Mein Opa sagte: Der Scheuerhof sei ein Ort, der nie das sein wollte, was Menschen aus ihm gemacht haben."
    k "Mäi Bopa huet gesot: De Scheuerhof wär en Ort, deen ni dat sollt sinn, wat d'Mënschen aus him gemaach hunn."

# game/renpy_scheuerhof.rpy:244
translate luxembourgish start_04bcde4f:

    # m "Meine Oma sprach von einem 'Hüter'. Etwas, das die Jesuiten gebunden haben, bevor man sie vertrieb."
    m "Meng Bomi huet vun engem 'Hüter' geschwat. Eppes, wat d'Jesuiten gebonnen hunn, ier een se verdriwwen huet."

# game/renpy_scheuerhof.rpy:246
translate luxembourgish start_ad5f1e72:

    # "Ein Funken springt aus dem Feuer. Für einen Moment sieht Lina darin eine Kutte. Ein Gesicht ohne Augen."
    "E Funk sprangt aus dem Feier. Fir e Moment gesäit d'Lina doranner eng Kutt. En Gesiicht ouni Aen."

# game/renpy_scheuerhof.rpy:256
translate luxembourgish start_80d61d99:

    # k "Er hat viel gesehen. Zu viel. Er mochte nicht darüber reden."
    k "Hie huet vill gesinn. Ze vill. Hie mocht net doriwwer schwätzen."

# game/renpy_scheuerhof.rpy:267
translate luxembourgish kai_opa_memory_445616e2:

    # k "Er war Sanitäter. Hat Leute gesehen, die hier gearbeitet haben."
    k "Hie war Sanitäter. Huet Leit gesinn, déi hei geschafft hunn."

# game/renpy_scheuerhof.rpy:268
translate luxembourgish kai_opa_memory_d221713c:

    # k "Er sagte, nachts habe man Schritte im alten Jesuitenflügel gehört."
    k "Hie sot, nuets hätt een Schrëtt am alen Jesuitefligel héieren."

# game/renpy_scheuerhof.rpy:269
translate luxembourgish kai_opa_memory_c360dfc5:

    # k "Obwohl der seit 1773 nicht mehr existiert. Seit die Jesuiten vertrieben wurden."
    k "Obwuel deen zënter 1773 net méi existéiert. Zënter d'Jesuiten verdriwwe goufen."

# game/renpy_scheuerhof.rpy:271
translate luxembourgish kai_opa_memory_39a33a80:

    # "Kai sieht ins Feuer. Sein Gesicht wirkt älter."
    "De Kai kuckt an d'Feier. Säi Gesiicht wierkt méi al."

# game/renpy_scheuerhof.rpy:273
translate luxembourgish kai_opa_memory_bff382ec:

    # k "Er hat mir einmal gesagt: 'Der Ort will nicht vergessen werden. Und er straft jeden, der es versucht.'"
    k "Hie huet mir emol gesot: 'Den Ort wëllt net vergiess ginn. An hie beschtrooft jiddereen, deen et probéiert.'"

# game/renpy_scheuerhof.rpy:287
translate luxembourgish pfad_der_stille_b810b202:

    # "Der Pfad zwischen Nohn und Dreisbach ist alt. Älter als die Dörfer. Älter als die Geschichten."
    "De Wee tëscht Nohn a Dreisbach ass al. Méi al wéi d'Dierfer. Méi al wéi d'Geschichten."

# game/renpy_scheuerhof.rpy:289
translate luxembourgish pfad_der_stille_30f558ef:

    # m "Hier sollen die Jesuiten ihre Prozessionen gemacht haben. Ein Brunnen, der nie austrocknete."
    m "Hei sollen d'Jesuiten hir Prozessiounen gemaach hunn. E Brunnen, dee ni ausgedréchent ass."

# game/renpy_scheuerhof.rpy:290
translate luxembourgish pfad_der_stille_e4bfbac8:

    # k "Mein Opa meinte, der Brunnen sei 'nicht von dieser Welt' gewesen."
    k "Mäi Bopa huet gemengt, de Brunnen wär 'net vun dëser Welt' gewiescht."

# game/renpy_scheuerhof.rpy:291
translate luxembourgish pfad_der_stille_af2d0ea1:

    # l "Ich spüre etwas. Wie Druck im Kopf. Als würde der Wald mich mustern."
    l "Ech spieren eppes. Wéi en Drock am Kapp. Wéi wann de Bësch mech muschterlecht ukuckt."

# game/renpy_scheuerhof.rpy:300
translate luxembourgish pfad_der_stille_83717f79:

    # k "Hey. Alles okay?"
    k "He. Alles okay?"

# game/renpy_scheuerhof.rpy:301
translate luxembourgish pfad_der_stille_d0557b84:

    # l "Keine Ahnung. Es fühlt sich an, als würde mich jemand ansehen. Aber da ist niemand."
    l "Keng Ahnung. Et fillt sech un, wéi wann mech ee géif ukucken. Awer do ass keen."

# game/renpy_scheuerhof.rpy:304
translate luxembourgish pfad_der_stille_276362ee:

    # k "Wenn's dir zu viel wird, sag's. Wir müssen hier nicht durch."
    k "Wann et der ze vill gëtt, sot et. Mir mussen hei net duerch."

# game/renpy_scheuerhof.rpy:306
translate luxembourgish pfad_der_stille_d2b6e829:

    # l "Nein. Ich will wissen, was das ist. Ich will nicht mehr denken, ich bild mir das nur ein."
    l "Nee. Ech wëll wëssen, wat dat ass. Ech wëll net méi denken, ech bild mir dat nëmmen an."

# game/renpy_scheuerhof.rpy:309
translate luxembourgish pfad_der_stille_aada73c5:

    # m "Du bildest dir gar nichts ein. Ich glaub dir."
    m "Du bilds der guer näischt an. Ech gleewen der."

# game/renpy_scheuerhof.rpy:311
translate luxembourgish pfad_der_stille_68743081:

    # "Kai sagt nichts. Aber er bleibt näher bei Lina als sonst."
    "De Kai seet näischt. Awer hie bleift méi no bei der Lina wéi soss."

# game/renpy_scheuerhof.rpy:320
translate luxembourgish pfad_der_stille_e57ff228:

    # l "Es ist, als würde jemand meinen Namen denken. Nicht sprechen. Denken."
    l "Et ass, wéi wann ee mäin Numm géif denken. Net schwätzen. Denken."

# game/renpy_scheuerhof.rpy:323
translate luxembourgish pfad_der_stille_4f97b646:

    # l "Ich rede mir das ein. Es ist nur Stille."
    l "Ech bild mir dat an. Et ass nëmmen Rou."

# game/renpy_scheuerhof.rpy:328
translate luxembourgish pfad_der_stille_d3fc35cb:

    # "Die Geräusche des Dorfes sind verschwunden. Nur der Wald bleibt."
    "D'Geräischer vum Duerf sinn verschwonnen. Nëmme de Bësch bleift."

# game/renpy_scheuerhof.rpy:342
translate luxembourgish lina_dream_70a0b090:

    # "In der Nacht träumt Lina von einer Kapelle, die nicht existiert."
    "An der Nuecht dreemt d'Lina vun enger Kapell, déi net existéiert."

# game/renpy_scheuerhof.rpy:344
translate luxembourgish lina_dream_636e2073:

    # "Kerzen. Stein. Ein Mann in einer Kutte. Kein Gesicht. Nur eine Leere, die sie ansieht."
    "Käerzen. Steen. E Mann an enger Kutt. Kee Gesiicht. Nëmmen eng Läiselechkeet, déi si ukuckt."

# game/renpy_scheuerhof.rpy:346
translate luxembourgish lina_dream_aee8f2a5:

    # h "Du hörst mich. Mehr als die anderen."
    h "Du héiers mech. Méi wéi déi aner."

# game/renpy_scheuerhof.rpy:348
translate luxembourgish lina_dream_236f83d3:

    # l "Wer bist du?"
    l "Wien bass du?"

# game/renpy_scheuerhof.rpy:349
translate luxembourgish lina_dream_c3e2cb75:

    # h "Ich bin der Wille des Ortes. Der Schatten der Geschichte."
    h "Ech sinn de Wëlle vum Ort. De Schiet vun der Geschicht."

# game/renpy_scheuerhof.rpy:352
translate luxembourgish lina_dream_b1bb6d36:

    # "Lina schreckt auf. Der Wald ist still. Aber das Flüstern bleibt."
    "D'Lina schreckt op. De Bësch ass roueg. Awer d'Flüsteren bleift."

# game/renpy_scheuerhof.rpy:373
translate luxembourgish ruine_a42c0942:

    # "Der Scheuerhof liegt wie ein verwundetes Tier im Wald. Die Mauern sind überwuchert, aber sie wirken nicht tot."
    "De Scheuerhof läit wéi en verwonnt Déier am Bësch. D'Maueren si mat Wiéck iwwerwuess, awer si wierken net dout."

# game/renpy_scheuerhof.rpy:375
translate luxembourgish ruine_0ee6b305:

    # "Kai bleibt kurz stehen. Nur eine Sekunde zu lange."
    "De Kai bleift kuerz stoen. Nëmmen eng Sekonn ze laang."

# game/renpy_scheuerhof.rpy:378
translate luxembourgish ruine_8adb7970:

    # k "Wir müssen da nicht rein, oder?"
    k "Mir mussen do net eran, oder?"

# game/renpy_scheuerhof.rpy:380
translate luxembourgish ruine_2a79386b:

    # m "Wir müssen. Ich hab die Kamera extra für sowas mitgenommen."
    m "Mir mussen. Ech hunn d'Kamera extra fir sou eppes matgeholl."

# game/renpy_scheuerhof.rpy:382
translate luxembourgish ruine_87e614e8:

    # l "Seit wann hast du Angst vor altem Gemäuer?"
    l "Zënter wéini hues du Angscht virun aler Mauerwierk?"

# game/renpy_scheuerhof.rpy:384
translate luxembourgish ruine_acdc24d0:

    # k "Seit mein Opa gesagt hat, ich soll nie wieder herkommen."
    k "Zënter mäi Bopa gesot huet, ech sollt ni méi hierkommen."

# game/renpy_scheuerhof.rpy:386
translate luxembourgish ruine_7355be9b:

    # "Er sagt es wie einen Scherz. Aber er meint es nicht so."
    "Hie seet et wéi e Witz. Awer hie mengt et net esou."

# game/renpy_scheuerhof.rpy:389
translate luxembourgish ruine_8cd3836d:

    # k "Mein Opa hat gesagt, manche Patienten hätten nachts geschrien, weil sie 'den Mann im Habit' gesehen hätten."
    k "Mäi Bopa huet gesot, munch Patiente hätten nuets geschriggen, well si 'de Mann am Habit' gesinn hätten."

# game/renpy_scheuerhof.rpy:390
translate luxembourgish ruine_2346bd74:

    # m "Ich mache ein Foto."
    m "Ech maachen e Foto."

# game/renpy_scheuerhof.rpy:393
translate luxembourgish ruine_0edacd9c:

    # "Mira drückt ab. Das Foto zeigt eine Gestalt. Groß. Kutte. Kein Gesicht."
    "D'Mira drécke lass. D'Foto weist eng Gestalt. Grouss. Kutt. Kee Gesiicht."

# game/renpy_scheuerhof.rpy:395
translate luxembourgish ruine_55989300:

    # m "Das… das kann nicht sein."
    m "Dat… dat kann net sinn."

# game/renpy_scheuerhof.rpy:397
translate luxembourgish ruine_fc4194e5:

    # l "Doch. Ich habe ihn im Feuer gesehen. Und im Traum."
    l "Duerch. Ech hunn hie am Feier gesinn. An am Dram."

# game/renpy_scheuerhof.rpy:400
translate luxembourgish ruine_364bcd34:

    # "Miras Hände zittern um die Kamera. Sie lässt sie trotzdem nicht los."
    "D'Mira hir Hänn zidderen ëm d'Kamera. Si léisst se awer net lass."

# game/renpy_scheuerhof.rpy:403
translate luxembourgish ruine_8fe539e5:

    # l "Zeig's mir nicht nochmal. Ich glaub dir auch so."
    l "Weis mir et net nach eng Kéier. Ech gleewen der och esou."

# game/renpy_scheuerhof.rpy:410
translate luxembourgish ruine_4f073b93:

    # k "Vielleicht ist das nur ein Bug in der Kamera. Oder ein Schatten."
    k "Vläicht ass dat just e Bug an der Kamera. Oder e Schiet."

# game/renpy_scheuerhof.rpy:414
translate luxembourgish ruine_41a8f210:

    # k "Das ist der Hüter. Genau so hat mein Opa ihn beschrieben."
    k "Dat ass den Hüter. Genau esou huet mäi Bopa hie beschriwwen."

# game/renpy_scheuerhof.rpy:418
translate luxembourgish ruine_c31824cf:

    # "Die Luft wird schwerer. Der Boden wird warm, als würde etwas darunter atmen."
    "D'Loft gëtt méi schwéier. De Buedem gëtt waarm, wéi wann eppes derënner otemt."

# game/renpy_scheuerhof.rpy:442
translate luxembourgish mira_oma_story_f7ae0e96:

    # m "Meine Oma war im Ferienheim hier angestellt."
    m "Meng Bomi war am Vakanzenheem hei ugestallt."

# game/renpy_scheuerhof.rpy:444
translate luxembourgish mira_oma_story_b89e9c10:

    # m "Sie sagte, nachts sei jemand durch die Flure gegangen, obwohl alle Türen abgeschlossen waren."
    m "Si sot, nuets wär een duerch d'Gäng gaangen, obwuel all Diere zougespaart waren."

# game/renpy_scheuerhof.rpy:446
translate luxembourgish mira_oma_story_0e6853c3:

    # m "Sie nannte ihn 'den Mann ohne Augen'."
    m "Si huet hie 'de Mann ouni Aen' genannt."

# game/renpy_scheuerhof.rpy:449
translate luxembourgish mira_oma_story_65fba9d3:

    # l "Deine Oma hat dir das erzählt? Nicht deine Eltern?"
    l "Deng Bomi huet der dat verzielt? Net deng Eltere?"

# game/renpy_scheuerhof.rpy:451
translate luxembourgish mira_oma_story_5784a143:

    # m "Meine Eltern reden nicht über sowas. Oma schon. Deshalb hab ich ihr geglaubt."
    m "Meng Eltere schwätzen net iwwer sou eppes. D'Bomi jo. Dofir hunn ech hir gegleeft."

# game/renpy_scheuerhof.rpy:453
translate luxembourgish mira_oma_story_4ae7991f:

    # "Mira hält die Kamera fester. Ihre Hände zittern."
    "D'Mira hält d'Kamera méi fest. Hir Hänn zidderen."

# game/renpy_scheuerhof.rpy:456
translate luxembourgish mira_oma_story_3bc8ae32:

    # m "Sie hat mir gesagt: 'Wenn du ihn siehst, dann sieht er dich auch.'"
    m "Si huet mir gesot: 'Wann du hie gesäis, dann gesäit hien dech och.'"

# game/renpy_scheuerhof.rpy:459
translate luxembourgish mira_oma_story_b2fa187e:

    # k "Und du machst trotzdem Fotos."
    k "An du méchs trotzdeem Fotoen."

# game/renpy_scheuerhof.rpy:461
translate luxembourgish mira_oma_story_a0da0ba1:

    # m "Gerade deshalb."
    m "Grad dofir."

# game/renpy_scheuerhof.rpy:483
translate luxembourgish kapelle_11eb7dfb:

    # "Die Jesuiten-Kapelle existiert nicht mehr. Und doch stehen sie darin."
    "D'Jesuitekapell existéiert net méi. An trotzdeem stinn si dran."

# game/renpy_scheuerhof.rpy:485
translate luxembourgish kapelle_e48e2a41:

    # "Kerzen brennen. Die Luft riecht nach Weihrauch und feuchtem Stein. Die Geometrie des Raumes ist falsch."
    "Käerzen brennen. D'Loft richt no Weihrauch a fiichtem Steen. D'Geometrie vum Raum ass falsch."

# game/renpy_scheuerhof.rpy:487
translate luxembourgish kapelle_5b68b7fd:

    # h "Ihr seid nicht die Ersten, die den Pfad der Stille betreten."
    h "Dir sidd net déi éischt, déi de Wee vun der Rou betrieden."

# game/renpy_scheuerhof.rpy:489
translate luxembourgish kapelle_236f83d3:

    # l "Wer bist du?"
    l "Wien bass du?"

# game/renpy_scheuerhof.rpy:490
translate luxembourgish kapelle_9e2267c4:

    # h "Ich bin das, was die Jesuiten gebunden haben, als sie vertrieben wurden."
    h "Ech sinn dat, wat d'Jesuiten gebonnen hunn, wéi si verdriwwe goufen."

# game/renpy_scheuerhof.rpy:498
translate luxembourgish kapelle_eccafaa8:

    # l "Warum zeigst du uns das? Was willst du von uns?"
    l "Firwat weis du eis dat? Wat wëlls du vun eis?"

# game/renpy_scheuerhof.rpy:499
translate luxembourgish kapelle_26435367:

    # h "Ich habe Jahrhunderte gewartet. Ich bin müde."
    h "Ech hu Joerhonnerte gewaart. Ech sinn midd."

# game/renpy_scheuerhof.rpy:502
translate luxembourgish kapelle_a3d81933:

    # l "…"
    l "…"

# game/renpy_scheuerhof.rpy:503
translate luxembourgish kapelle_64d0c346:

    # h "Schweigen ist auch eine Antwort."
    h "Schweigen ass och eng Äntwert."

# game/renpy_scheuerhof.rpy:505
translate luxembourgish kapelle_0423fd54:

    # "Die Kapelle flackert. Als wäre sie nur ein Gedanke."
    "D'Kapell flackert. Wéi wann si nëmmen e Gedanken wär."

# game/renpy_scheuerhof.rpy:521
translate luxembourgish huter_monolog_69f47fbe:

    # h "Ich bin nicht Mensch. Ich bin nicht Geist. Ich bin Erinnerung."
    h "Ech sinn kee Mënsch. Ech sinn kee Geescht. Ech sinn Erënnerung."

# game/renpy_scheuerhof.rpy:522
translate luxembourgish huter_monolog_35a00617:

    # h "Ich bin der Wille eines Ortes, der nicht vergessen werden will."
    h "Ech sinn de Wëlle vun engem Ort, deen net vergiess ginn wëllt."

# game/renpy_scheuerhof.rpy:524
translate luxembourgish huter_monolog_d110ab97:

    # h "Als die Jesuiten gingen, ließen sie mich zurück. Gebunden. Namenlos."
    h "Wéi d'Jesuiten gaangen sinn, hu si mech zréckgelooss. Gebonnen. Ouni Numm."

# game/renpy_scheuerhof.rpy:533
translate luxembourgish huter_monolog_f827ed7d:

    # l "Wenn du Erinnerung bist… was passiert, wenn niemand mehr von dir weiß?"
    l "Wann du Erënnerung bass… wat geschitt, wann keen méi vun der weess?"

# game/renpy_scheuerhof.rpy:534
translate luxembourgish huter_monolog_d60325c9:

    # h "Dann werde ich laut."
    h "Da ginn ech haart."

# game/renpy_scheuerhof.rpy:537
translate luxembourgish huter_monolog_c771b353:

    # k "Das ist Wahnsinn. Wir halluzinieren."
    k "Dat ass Waansinn. Mir halluzinéieren."

# game/renpy_scheuerhof.rpy:538
translate luxembourgish huter_monolog_233a3ee7:

    # h "Ihr könnt gehen. Aber ich bleibe."
    h "Dir kënnt goen. Awer ech bleiwen."

# game/renpy_scheuerhof.rpy:540
translate luxembourgish huter_monolog_098f99c7:

    # "Die Kapelle beginnt zu zerfallen. Stein wird zu Staub."
    "D'Kapell fänkt un ze verfalen. Steen gëtt zu Stëbs."

# game/renpy_scheuerhof.rpy:556
translate luxembourgish krankensaal_e43b7953:

    # "Betten. Schatten. Flüstern. Patienten ohne Gesichter."
    "Better. Schiedelen. Flüsteren. Patienten ouni Gesiichter."

# game/renpy_scheuerhof.rpy:558
translate luxembourgish krankensaal_e35bbc74:

    # "Ein Arzt spricht mit einer unsichtbaren Gestalt. Seine Stimme ist brüchig."
    "En Dokter schwätzt mat enger onsiichtbarer Gestalt. Seng Stëmm ass brëchel."

# game/renpy_scheuerhof.rpy:560
translate luxembourgish krankensaal_d7ad86a4:

    # "Eine Krankenschwester schreibt in ihr Tagebuch: 'Der Ort will nicht, dass wir hier sind.'"
    "Eng Krankeschwëster schreift an hiert Dagebuch: 'Den Ort wëllt net, dass mir hei sinn.'"

# game/renpy_scheuerhof.rpy:562
translate luxembourgish krankensaal_3d662a9c:

    # m "Meine Oma hat von Nächten erzählt, in denen niemand schlafen konnte."
    m "Meng Bomi huet vun Nächten verzielt, an deenen keen schlofe konnt."

# game/renpy_scheuerhof.rpy:563
translate luxembourgish krankensaal_2fde2fab:

    # k "Mein Opa sagte, der Ort wolle nicht, dass Menschen hier bleiben."
    k "Mäi Bopa sot, den Ort wéilt net, dass Mënschen hei bleiwen."

# game/renpy_scheuerhof.rpy:565
translate luxembourgish krankensaal_e5f1e74a:

    # h "Ich bin nicht der Fluch. Ich bin nur sein Werkzeug. Der Fluch liegt im Boden. In den Steinen. In der Geschichte."
    h "Ech sinn net de Fluch. Ech sinn nëmmen säin Instrument. De Fluch läit am Buedem. An de Steng. An der Geschicht."

# game/renpy_scheuerhof.rpy:573
translate luxembourgish krankensaal_0d0d12b2:

    # l "Dann hör auf. Lass den Ort los."
    l "Da hal op. Looss den Ort lass."

# game/renpy_scheuerhof.rpy:574
translate luxembourgish krankensaal_3fed4295:

    # h "Ich kann nicht. Ich bin gebunden. Aber ihr könnt entscheiden, ob ich allein bleibe."
    h "Ech kann net. Ech sinn gebonnen. Awer dir kënnt entscheeden, ob ech eleng bleiwen."

# game/renpy_scheuerhof.rpy:577
translate luxembourgish krankensaal_231e8291:

    # l "Wir sollten gehen."
    l "Mir sollte goen."

# game/renpy_scheuerhof.rpy:578
translate luxembourgish krankensaal_c0931ab5:

    # h "Ihr könnt gehen. Aber ihr nehmt mich mit, ob ihr wollt oder nicht."
    h "Dir kënnt goen. Awer dir hut mech mat, ob dir wëllt oder net."

# game/renpy_scheuerhof.rpy:594
translate luxembourgish pockenstation_5eaac438:

    # "Der Betonblock steht kalt und feucht im Wald. Die Stille ist schwer wie Wasser."
    "De Betonblock steet kal a fiicht am Bësch. D'Rou ass schwéier wéi Waasser."

# game/renpy_scheuerhof.rpy:596
translate luxembourgish pockenstation_80d75ab9:

    # k "Die haben das 1970 gebaut. Für Pockenfälle. Aber eröffnet wurde sie nie - die Pocken waren so gut wie besiegt, bevor der erste Patient herkam."
    k "Déi hunn dat 1970 gebaut. Fir Pockefäll. Awer opgemaach gouf se ni - d'Pocken waren esou gutt wéi besiegt, ier de éischte Patient hierkoum."

# game/renpy_scheuerhof.rpy:597
translate luxembourgish pockenstation_748fe602:

    # h "So steht es in euren Akten. Vielleicht stimmt es sogar."
    h "Sou steet et an äre Akten. Vläicht stëmmt et souguer."

# game/renpy_scheuerhof.rpy:600
translate luxembourgish pockenstation_0c4c72b8:

    # k "Was soll das heißen?"
    k "Wat soll dat heeschen?"

# game/renpy_scheuerhof.rpy:601
translate luxembourgish pockenstation_912ccb9f:

    # h "Nur, dass ich froh war, als sie die Pläne wieder einstampften. Manche Orte sollten leer bleiben."
    h "Nëmmen, dass ech frou war, wéi si d'Pläng nees ofgesot hunn. Munch Plazen sollte eidel bleiwen."

# game/renpy_scheuerhof.rpy:610
translate luxembourgish pockenstation_71a77ad3:

    # m "Wenn wir deine Geschichte erzählen, bist du nicht mehr allein."
    m "Wa mir deng Geschicht erzielen, bass du net méi eleng."

# game/renpy_scheuerhof.rpy:611
translate luxembourgish pockenstation_00eea4a3:

    # h "Erzählen ist Macht. Ihr müsst vorsichtig sein, wem ihr sie gebt."
    h "Erzielen ass Muecht. Dir musst oppassen, wiem dir se gitt."

# game/renpy_scheuerhof.rpy:614
translate luxembourgish pockenstation_6f3656a8:

    # m "Manche Dinge wollen vergessen werden."
    m "Munch Saache wëllen vergiess ginn."

# game/renpy_scheuerhof.rpy:615
translate luxembourgish pockenstation_0f190c42:

    # h "Vergessen ist auch eine Entscheidung. Aber ich werde mich wehren."
    h "Vergiessen ass och eng Entscheedung. Awer ech wäert mech wieren."

# game/renpy_scheuerhof.rpy:620
translate luxembourgish pockenstation_b70f879c:

    # "Ein dumpfer Schlag hallt durch den Beton. Niemand weiß, woher er kommt."
    "En domme Schlag hallt duerch de Beton. Keen weess, wou hie hierkënnt."

# game/renpy_scheuerhof.rpy:636
translate luxembourgish archiv_c931e460:

    # "Ein Archiv, das nie existiert hat. Regale, die sich bewegen. Bücher, die flüstern."
    "En Archiv, dat ni existéiert huet. Regaler, déi sech beweegen. Bicher, déi flüsteren."

# game/renpy_scheuerhof.rpy:638
translate luxembourgish archiv_b04d88da:

    # "Pergamente blättern sich selbst um. Schatten wirken wie Hände."
    "Pergamenter blieder sech selwer ëm. Schiedelen wierken wéi Hänn."

# game/renpy_scheuerhof.rpy:640
translate luxembourgish archiv_e18034d3:

    # h "Die Jesuiten wollten den Ort schützen. Nicht beherrschen."
    h "D'Jesuiten wollte den Ort schützen. Net beherrschen."

# game/renpy_scheuerhof.rpy:642
translate luxembourgish archiv_c8cd6917:

    # h "Ich war ein Wächter. Kein Fluch."
    h "Ech war e Wiechter. Kee Fluch."

# game/renpy_scheuerhof.rpy:645
translate luxembourgish archiv_bc576460:

    # l "Was ist passiert?"
    l "Wat ass geschitt?"

# game/renpy_scheuerhof.rpy:646
translate luxembourgish archiv_d71cdb88:

    # h "Vergessen. Vergessen ist schlimmer als Tod."
    h "Vergiessen. Vergiessen ass méi schlëmm wéi den Doud."

# game/renpy_scheuerhof.rpy:648
translate luxembourgish archiv_81c01795:

    # "Ein Buch fällt aus dem Regal. Es öffnet sich. Darin: ein Name."
    "En Buch fält aus dem Regal. Et geet op. Dran: en Numm."

# game/renpy_scheuerhof.rpy:651
translate luxembourgish archiv_0ffae331:

    # m "Das ist… dein Name?"
    m "Dat ass… däin Numm?"

# game/renpy_scheuerhof.rpy:652
translate luxembourgish archiv_fe161920:

    # h "Der Name, den ich hatte, bevor ich gebunden wurde."
    h "Den Numm, deen ech haat, ier ech gebonnen gouf."

# game/renpy_scheuerhof.rpy:660
translate luxembourgish archiv_363582e4:

    # l "Ich werde dich nicht vergessen."
    l "Ech wäert dech net vergiessen."

# game/renpy_scheuerhof.rpy:661
translate luxembourgish archiv_c3b26b6f:

    # h "Dann bin ich nicht allein."
    h "Dann sinn ech net eleng."

# game/renpy_scheuerhof.rpy:665
translate luxembourgish archiv_a6de0ed9:

    # k "Wenn das hier echt ist… dann müssen wir etwas tun."
    k "Wann dat hei echt ass… da mussen mir eppes maachen."

# game/renpy_scheuerhof.rpy:666
translate luxembourgish archiv_8d482592:

    # h "Mut ist Erinnerung."
    h "Mutt ass Erënnerung."

# game/renpy_scheuerhof.rpy:670
translate luxembourgish archiv_eeba09b1:

    # m "Ich dokumentiere es. Damit es nicht verloren geht."
    m "Ech dokumentéieren et. Domat et net verluer geet."

# game/renpy_scheuerhof.rpy:671
translate luxembourgish archiv_baa7e761:

    # h "Du bist meine Chronistin."
    h "Du bass meng Chronistin."

# game/renpy_scheuerhof.rpy:673
translate luxembourgish archiv_d8c305e0:

    # "Das Archiv beginnt zu brennen — aber rückwärts. Die Flammen ziehen sich zurück."
    "D'Archiv fänkt un ze brennen — awer réckwäerts. D'Flame zéien sech zréck."

# game/renpy_scheuerhof.rpy:713
translate luxembourgish jesuiten_dokument_a6b696ed:

    # "Ein Pergament liegt auf einem Pult. Die Schrift ist alt, aber lesbar."
    "E Pergament läit op engem Pult. D'Schrëft ass al, awer liesbar."

# game/renpy_scheuerhof.rpy:715
translate luxembourgish jesuiten_dokument_b62bf268:

    # "»Anno Domini 1673. Wir, die Brüder der Gesellschaft Jesu, haben am Orte Scheuerhof eine kleine Kapelle errichtet.«"
    "»Anno Domini 1673. Mir, d'Bridder vun der Gesellschaft Jesu, hunn um Ort Scheuerhof eng kleng Kapell gebaut.«"

# game/renpy_scheuerhof.rpy:717
translate luxembourgish jesuiten_dokument_8c67e132:

    # "»Der Brunnen spendet Wasser ohne Unterlass. Die Leute sagen, er sei ein Wunder. Wir sagen, er sei ein Zeichen.«"
    "»De Brunnen spend Waasser ouni Ophalen. D'Leit soen, hie wär e Wonner. Mir soen, hie wär e Zeeche.«"

# game/renpy_scheuerhof.rpy:719
translate luxembourgish jesuiten_dokument_a821151c:

    # "»In den Nächten sehen wir Lichter im Walde. Wir hören Stimmen, die nicht von Menschen stammen.«"
    "»An den Nächten gesi mir Luuchten am Bësch. Mir héieren Stëmmen, déi net vu Mënsche kommen.«"

# game/renpy_scheuerhof.rpy:721
translate luxembourgish jesuiten_dokument_03d5f771:

    # "»Wir halten fest: Dieser Ort hat einen Willen. Möge Gott uns lehren, ihn zu verstehen.«"
    "»Mir halen fest: Dëse Ort huet e Wëlle. Méi Gott eis léieren, hie ze verstoen.«"

# game/renpy_scheuerhof.rpy:723
translate luxembourgish jesuiten_dokument_43cf85a1:

    # m "Das ist… eine echte Chronik. Oder etwas, das sich so anfühlt."
    m "Dat ass… eng echt Chronik. Oder eppes, wat sech esou uféilt."

# game/renpy_scheuerhof.rpy:725
translate luxembourgish jesuiten_dokument_b0e6a9ad:

    # l "Es macht alles… schwerer. Aber auch klarer."
    l "Et mécht alles… méi schwéier. Awer och méi kloer."

# game/renpy_scheuerhof.rpy:727
translate luxembourgish jesuiten_dokument_c9217f5b:

    # k "Sie wussten, dass hier etwas ist. Und sie sind trotzdem geblieben."
    k "Si wossten, dass hei eppes ass. An si sinn trotzdeem bliwwen."

# game/renpy_scheuerhof.rpy:812
translate luxembourgish wald_wille_7ffc46c5:

    # "Der Wald ist nicht mehr der Wald. Die Bäume bewegen sich leicht, als würden sie atmen."
    "De Bësch ass net méi de Bësch. D'Beem beweegen sech liicht, wéi wa se otemen."

# game/renpy_scheuerhof.rpy:814
translate luxembourgish wald_wille_a139dcb0:

    # "Wurzeln wirken wie Adern. Das Licht kommt aus keiner Richtung. Geräusche klingen rückwärts."
    "Wuerzelen wierken wéi Ueder. D'Luucht kënnt aus keng Richtung. Geräischer klénge réckwäerts."

# game/renpy_scheuerhof.rpy:816
translate luxembourgish wald_wille_f74ac9d5:

    # l "Das ist… falsch."
    l "Dat ass… falsch."

# game/renpy_scheuerhof.rpy:817
translate luxembourgish wald_wille_b23e0e01:

    # k "Das ist nicht mehr unser Wald."
    k "Dat ass net méi eise Bësch."

# game/renpy_scheuerhof.rpy:818
translate luxembourgish wald_wille_7229805a:

    # m "Ich… ich glaube, der Wald sieht uns."
    m "Ech… ech gleewen, de Bësch gesäit eis."

# game/renpy_scheuerhof.rpy:820
translate luxembourgish wald_wille_a36c93d7:

    # h "Der Wald ist Teil von mir. Teil des Ortes. Teil des Fluchs."
    h "De Bësch ass Deel vu mir. Deel vum Ort. Deel vum Fluch."

# game/renpy_scheuerhof.rpy:822
translate luxembourgish wald_wille_7a80328b:

    # h "Er will nicht zerstört werden. Er will nicht bebaut werden. Er will nicht vergessen werden."
    h "Hie wëllt net zerstéiert ginn. Hie wëllt net bebaut ginn. Hie wëllt net vergiess ginn."

# game/renpy_scheuerhof.rpy:831
translate luxembourgish wald_wille_15519be2:

    # l "Wenn der Wald ein Wille ist… dann ist er nicht böse. Nur… lebendig."
    l "Wann de Bësch e Wëlle ass… dann ass hie net béis. Just… lieweg."

# game/renpy_scheuerhof.rpy:832
translate luxembourgish wald_wille_0d271e58:

    # h "Lebendig genug, um zu leiden."
    h "Lieweg genuch, fir ze leiden."

# game/renpy_scheuerhof.rpy:835
translate luxembourgish wald_wille_8142b7e2:

    # k "Das ist zu viel. Das ist nicht real."
    k "Dat ass ze vill. Dat ass net real."

# game/renpy_scheuerhof.rpy:836
translate luxembourgish wald_wille_c3906d1a:

    # h "Real ist, was erinnert wird."
    h "Real ass, wat erënnert gëtt."

# game/renpy_scheuerhof.rpy:838
translate luxembourgish wald_wille_4b068e6d:

    # "Ein Baum neigt sich. Nicht durch Wind. Durch Absicht."
    "E Bam beit sech. Net duerch Wand. Duerch Absicht."

# game/renpy_scheuerhof.rpy:840
translate luxembourgish wald_wille_d2aa8ccb:

    # h "Ihr müsst entscheiden, ob ich allein bleibe."
    h "Dir musst entscheeden, ob ech eleng bleiwen."

# game/renpy_scheuerhof.rpy:856
translate luxembourgish jesuiten_block_2_6587f5f6:

    # h "Ich war ein Mönch. Pater Amandus Dreisbach."
    h "Ech war e Mönch. Pater Amandus Dreisbach."

# game/renpy_scheuerhof.rpy:857
translate luxembourgish jesuiten_block_2_aeb54bfd:

    # h "Ich hörte den Wald. Den Brunnen. Die Siedlung, die längst verschwunden war."
    h "Ech hunn de Bësch héieren. De Brunnen. D'Siidlung, déi längst verschwonnen war."

# game/renpy_scheuerhof.rpy:859
translate luxembourgish jesuiten_block_2_51032cb1:

    # h "Als die Jesuiten vertrieben wurden, wollten sie mich mitnehmen."
    h "Wéi d'Jesuiten verdriwwe goufen, wollte si mech matholl."

# game/renpy_scheuerhof.rpy:860
translate luxembourgish jesuiten_block_2_dccfd3d0:

    # h "Aber ich war zu tief mit dem Ort verbunden."
    h "Awer ech war ze déif mam Ort verbonnen."

# game/renpy_scheuerhof.rpy:862
translate luxembourgish jesuiten_block_2_d56e0f82:

    # h "Sie banden mich. Nicht mit Ketten. Mit Gebeten. Mit Erinnerung."
    h "Si hunn mech gebonnen. Net mat Ketten. Mat Gebieder. Mat Erënnerung."

# game/renpy_scheuerhof.rpy:863
translate luxembourgish jesuiten_block_2_6c57edf7:

    # h "Sie ließen mich zurück. Und sie nahmen meinen Namen mit."
    h "Si hu mech zréckgelooss. An si hunn mäi Numm matgeholl."

# game/renpy_scheuerhof.rpy:879
translate luxembourgish ritual_bindung_33bafeb5:

    # "Die Kapelle ist voll. Jesuiten in dunklen Gewändern. Kerzen flackern. Der Wald drückt gegen die Mauern."
    "D'Kapell ass voll. Jesuiten a donkelen Gewänner. Käerzen flackeren. De Bësch dréckt géint d'Maueren."

# game/renpy_scheuerhof.rpy:881
translate luxembourgish ritual_bindung_22beb64d:

    # "Pater Amandus kniet vor dem Altar. Seine Hände zittern."
    "De Pater Amandus knéit virum Altor. Seng Hänn zidderen."

# game/renpy_scheuerhof.rpy:883
translate luxembourgish ritual_bindung_b68fa490:

    # "Ein älterer Jesuit spricht: 'Bruder Amandus, du bist der Einzige, der den Ort hört. Wenn wir gehen, bleibt er zurück.'"
    "En eelere Jesuit schwätzt: 'Brudder Amandus, du bass deen eenzegen, deen den Ort héiert. Wa mir goen, bleift hien zréck.'"

# game/renpy_scheuerhof.rpy:885
translate luxembourgish ritual_bindung_90036352:

    # "Amandus flüstert: 'Dann bleibe ich auch.'"
    "Amandus flüstert: 'Dann bleiwen ech och.'"

# game/renpy_scheuerhof.rpy:887
translate luxembourgish ritual_bindung_fd2d5836:

    # "Sie legen ihm die Hände auf. Sie sprechen Gebete. Lateinische Worte, die wie Ketten klingen."
    "Si leeën him d'Hänn op. Si schwätzen Gebieder. Laténgesch Wierder, déi wéi Ketten klénken."

# game/renpy_scheuerhof.rpy:889
translate luxembourgish ritual_bindung_f3340075:

    # "Der Wald antwortet. Ein dumpfes Grollen. Die Mauern atmen."
    "De Bësch äntwert. En dommt Grollen. D'Maueren otemen."

# game/renpy_scheuerhof.rpy:891
translate luxembourgish ritual_bindung_4545f0cb:

    # h "Ich habe zugestimmt. Ich habe mich binden lassen. Ich dachte, es sei ein Dienst."
    h "Ech hunn zougestëmmt. Ech hunn mech bannen loossen. Ech hunn geduecht, et wär en Déngscht."

# game/renpy_scheuerhof.rpy:893
translate luxembourgish ritual_bindung_fe2cb7d6:

    # "Die Kerzen verlöschen. Nur der Brunnen leuchtet."
    "D'Käerzen erlëschen. Nëmme de Brunnen liicht."

# game/renpy_scheuerhof.rpy:895
translate luxembourgish ritual_bindung_08d57c18:

    # "Als die Jesuiten gehen, bleibt Amandus zurück. Allein. Gebunden. Namenlos."
    "Wéi d'Jesuiten goen, bleift den Amandus zréck. Eleng. Gebonnen. Ouni Numm."

# game/renpy_scheuerhof.rpy:911
translate luxembourgish hueter_name_4b21a055:

    # "Ein Pergament fällt aus dem Regal. Ein Name steht darauf."
    "E Pergament fält aus dem Regal. En Numm steet drop."

# game/renpy_scheuerhof.rpy:913
translate luxembourgish hueter_name_e5e5d328:

    # m "Amandus… Dreisbach."
    m "Amandus… Dreisbach."

# game/renpy_scheuerhof.rpy:914
translate luxembourgish hueter_name_c7f57512:

    # l "Das ist dein Name."
    l "Dat ass däin Numm."

# game/renpy_scheuerhof.rpy:915
translate luxembourgish hueter_name_f144f6c2:

    # h "Es war mein Name. Bevor ich vergessen wurde."
    h "Et war mäin Numm. Ier ech vergiess gouf."

# game/renpy_scheuerhof.rpy:1021
translate luxembourgish erholungsheim_sanatorium_c4305c45:

    # "1950. Die Kreissparkasse Saarbrücken übernimmt das Haus als Erholungsheim für ihre Angestellten."
    "1950. D'Kreissparkasse Saarbrécken iwwerhëlt d'Haus als Erholungsheem fir hir Ugestallten."

# game/renpy_scheuerhof.rpy:1023
translate luxembourgish erholungsheim_sanatorium_a8144cbd:

    # h "Wieder Menschen, die einfach nur atmen wollten. Ein paar Wochen im Grünen."
    h "Erëm Mënschen, déi einfach nëmmen otme wollten. E puer Wochen am Gréngen."

# game/renpy_scheuerhof.rpy:1025
translate luxembourgish erholungsheim_sanatorium_8bdbbbff:

    # m "Moment. War das... war das nicht das Ferienheim, von dem meine Oma erzählt hat?"
    m "Ee Moment. War dat... war dat net d'Vakanzenheem, vun deem meng Bomi verzielt huet?"

# game/renpy_scheuerhof.rpy:1026
translate luxembourgish erholungsheim_sanatorium_08988ea7:

    # h "Ja. Ich erinnere mich an sie. Sie hat nie geschrien, als sie mich gespürt hat. Nur genickt. Als würde sie verstehen."
    h "Jo. Ech erënnere mech un si. Si huet ni geschriggen, wéi si mech gespuert huet. Nëmmen genéckt. Wéi wann si verstoung."

# game/renpy_scheuerhof.rpy:1028
translate luxembourgish erholungsheim_sanatorium_05eeebde:

    # "Mira sagt nichts. Aber ihre Hand zittert nicht mehr vor Angst. Nur vor Rührung."
    "D'Mira seet näischt. Awer hir Hand zidderen net méi virun Angscht. Nëmme virun Réierung."

# game/renpy_scheuerhof.rpy:1030
translate luxembourgish erholungsheim_sanatorium_201a82d5:

    # "Fünf Jahre später verändert sich das Haus wieder. Neue Schilder. Weiße Kittel. Betten in Reihen."
    "Fënnef Joer méi spéit ännert sech d'Haus nees. Nei Schëlter. Wäiss Kittel. Better a Reihen."

# game/renpy_scheuerhof.rpy:1033
translate luxembourgish erholungsheim_sanatorium_2abcf076:

    # k "Das haben wir schon gesehen."
    k "Dat hu mir schonn gesinn."

# game/renpy_scheuerhof.rpy:1034
translate luxembourgish erholungsheim_sanatorium_49043991:

    # h "Ja. Das Lungensanatorium. Ich habe es euch früher gezeigt, bevor ihr wusstet, wer ich bin."
    h "Jo. D'Lungensanatorium. Ech hunn et iech méi fréi gewisen, ier dir gewosst hutt, wien ech sinn."

# game/renpy_scheuerhof.rpy:1037
translate luxembourgish erholungsheim_sanatorium_8d409e86:

    # l "War das der Anfang vom Ende?"
    l "War dat den Ufank vum Enn?"

# game/renpy_scheuerhof.rpy:1038
translate luxembourgish erholungsheim_sanatorium_01f94535:

    # h "Nein. Der Anfang vom Ende kam später. Als niemand mehr fragte, was hier war. Nur noch, was hier sein könnte."
    h "Nee. Den Ufank vum Enn koum méi spéit. Wéi keen méi gefrot huet, wat hei war. Nëmme méi, wat hei kéint sinn."

# game/renpy_scheuerhof.rpy:1101
translate luxembourgish huter_bruch_879043d1:

    # "Die Kapelle erscheint erneut. Aber sie zerfällt. Kerzen brennen rückwärts. Schatten lösen sich."
    "D'Kapell erschéngt nees. Awer si verfällt. Käerzen brennen réckwäerts. Schiedelen léisen sech."

# game/renpy_scheuerhof.rpy:1103
translate luxembourgish huter_bruch_f9bb2337:

    # h "Ihr habt jetzt alles gesehen. Die guten Jahre. Die schlechten. Und das, was übrig bleibt, wenn niemand mehr fragt."
    h "Dir hutt elo alles gesinn. D'gutt Joeren. D'schlecht. An dat, wat bleift, wa keen méi freet."

# game/renpy_scheuerhof.rpy:1105
translate luxembourgish huter_bruch_70ca849f:

    # h "Ich war ein Mönch. Ich hatte einen Namen. Ich hatte ein Leben."
    h "Ech war e Mönch. Ech haat en Numm. Ech haat e Liewen."

# game/renpy_scheuerhof.rpy:1107
translate luxembourgish huter_bruch_28e150a7:

    # h "Als die Jesuiten gingen, ließen sie mich zurück. Gebunden. Namenlos. Vergessen."
    h "Wéi d'Jesuiten gaange sinn, hu si mech zréckgelooss. Gebonnen. Ouni Numm. Vergiess."

# game/renpy_scheuerhof.rpy:1109
translate luxembourgish huter_bruch_d38b4412:

    # l "Du bist… du bist nicht böse."
    l "Du bass… du bass net béis."

# game/renpy_scheuerhof.rpy:1110
translate luxembourgish huter_bruch_6447e5a4:

    # h "Ich bin müde."
    h "Ech sinn midd."

# game/renpy_scheuerhof.rpy:1112
translate luxembourgish huter_bruch_b40141ea:

    # "Der Hüter zeigt seine wahre Form. Kein Gesicht. Kein Körper. Nur Erinnerung, die Gestalt angenommen hat."
    "Den Hüter weist seng richteg Form. Kee Gesiicht. Kee Kierper. Nëmmen Erënnerung, déi Gestalt ugeholl huet."

# game/renpy_scheuerhof.rpy:1114
translate luxembourgish huter_bruch_b49ed0fe:

    # h "Ich will nicht vergessen werden."
    h "Ech wëll net vergiess ginn."

# game/renpy_scheuerhof.rpy:1123
translate luxembourgish huter_bruch_954dd233:

    # l "Wir werden dich nicht vergessen."
    l "Mir wäerten dech net vergiessen."

# game/renpy_scheuerhof.rpy:1124
translate luxembourgish huter_bruch_c3b26b6f:

    # h "Dann bin ich nicht allein."
    h "Dann sinn ech net eleng."

# game/renpy_scheuerhof.rpy:1126
translate luxembourgish huter_bruch_a3d81933:

    # l "…"
    l "…"

# game/renpy_scheuerhof.rpy:1127
translate luxembourgish huter_bruch_24fa0dd0:

    # h "Schweigen ist der erste Schritt zum Vergessen."
    h "Schweigen ass den éischte Schrëtt zum Vergiessen."

# game/renpy_scheuerhof.rpy:1143
translate luxembourgish entscheidung_535f4bfe:

    # "Sie stehen wieder im realen Scheuerhof. Die Ruine ist still. Der Wald ist wach."
    "Si stinn erëm am reelle Scheuerhof. D'Ruin ass roueg. De Bësch ass waakreg."

# game/renpy_scheuerhof.rpy:1145
translate luxembourgish entscheidung_798085ed:

    # h "Ihr kennt meine Geschichte. Ihr kennt meinen Namen."
    h "Dir kennt meng Geschicht. Dir kennt mäi Numm."

# game/renpy_scheuerhof.rpy:1146
translate luxembourgish entscheidung_9911b309:

    # h "Jetzt müsst ihr entscheiden, ob ich allein bleibe."
    h "Elo musst dir entscheeden, ob ech eleng bleiwen."

# game/renpy_scheuerhof.rpy:1171
translate luxembourgish ending_alternative_3771dd1d:

    # "Ein Zeitungsartikel über das geplante Schießzentrum. Daneben ein Bericht über die Geschichte des Scheuerhofs."
    "En Zeitungsartikel iwwer d'geplangten Schéisszentrum. Niewendrun e Bericht iwwer d'Geschicht vum Scheuerhof."

# game/renpy_scheuerhof.rpy:1173
translate luxembourgish ending_alternative_23192429:

    # m "Wir haben alles veröffentlicht. Fotos, Berichte, Aussagen."
    m "Mir hunn alles verëffentlecht. Fotoen, Bericher, Aussoen."

# game/renpy_scheuerhof.rpy:1174
translate luxembourgish ending_alternative_8c3f6a24:

    # k "Die Leute reden jetzt darüber. Aber sie reden auch über 'Entwicklung'."
    k "D'Leit schwätze elo doriwwer. Awer si schwätzen och iwwer 'Entwécklung'."

# game/renpy_scheuerhof.rpy:1175
translate luxembourgish ending_alternative_4936aa47:

    # l "Der Hüter ist nicht mehr allein. Aber der Ort ist nicht mehr geschützt."
    l "Den Hüter ass net méi eleng. Awer den Ort ass net méi geschützt."

# game/renpy_scheuerhof.rpy:1177
translate luxembourgish ending_alternative_5595eb15:

    # "Der Wald flüstert. Nicht wütend. Aber unruhig."
    "De Bësch flüstert. Net wéidend. Awer onroueg."

# game/renpy_scheuerhof.rpy:1189
translate luxembourgish ending_true_05e2666e:

    # "Kein Schießzentrum. Stattdessen ein kleiner Beitrag über 'geschützte historische Orte'."
    "Kee Schéisszentrum. Amplaz e klenge Bäitrag iwwer 'geschützte historesch Plazen'."

# game/renpy_scheuerhof.rpy:1191
translate luxembourgish ending_true_20324d52:

    # m "Wir haben die Geschichte erzählt. Aber nicht laut. Nur den richtigen Menschen."
    m "Mir hunn d'Geschicht erzielt. Awer net haart. Nëmme fir déi richteg Leit."

# game/renpy_scheuerhof.rpy:1192
translate luxembourgish ending_true_82796cff:

    # k "Die Gemeinde hat beschlossen, hier nichts mehr zu bauen."
    k "D'Gemeng huet decidéiert, hei näischt méi ze bauen."

# game/renpy_scheuerhof.rpy:1193
translate luxembourgish ending_true_39d1efbf:

    # l "Der Hüter ist nicht mehr allein. Und der Ort bleibt, was er ist."
    l "Den Hüter ass net méi eleng. An den Ort bleift, wat hie ass."

# game/renpy_scheuerhof.rpy:1196
translate luxembourgish ending_true_eeaf042f:

    # "Sie haben den Hüter verstanden. Sie haben den Ort geschützt. Das ist das wahre Ende."
    "Si hunn den Hüter verstanen. Si hunn den Ort geschützt. Dat ass dat richtegt Enn."

# game/renpy_scheuerhof.rpy:1198
translate luxembourgish ending_true_d1e101d0:

    # "Sie haben viel getan. Aber etwas bleibt ungesagt."
    "Si hunn vill gemaach. Awer eppes bleift ongesot."

# game/renpy_scheuerhof.rpy:1200
translate luxembourgish ending_true_5da69219:

    # "Der Wald atmet. Zum ersten Mal wirkt er ruhig."
    "De Bësch otemt. Fir dat éischt Mol wierkt hie roueg."

# game/renpy_scheuerhof.rpy:1234
translate luxembourgish ending_hidden_6fb966c4:

    # "Die Kapelle erscheint ein letztes Mal. Lina steht allein vor dem Hüter."
    "D'Kapell erschéngt e läscht Mol. D'Lina steet eleng virum Hüter."

# game/renpy_scheuerhof.rpy:1236
translate luxembourgish ending_hidden_0056d78d:

    # h "Du bist die Einzige, die mich hört."
    h "Du bass déi Eenzeg, déi mech héiert."

# game/renpy_scheuerhof.rpy:1238
translate luxembourgish ending_hidden_f2247ffd:

    # l "Und genau deshalb… muss ich dich vergessen."
    l "An genau dofir… muss ech dech vergiessen."

# game/renpy_scheuerhof.rpy:1240
translate luxembourgish ending_hidden_337b14c1:

    # "Der Hüter zerfällt. Nicht in Staub. In Stille."
    "Den Hüter verfällt. Net an Stëbs. An Rou."

# game/renpy_scheuerhof.rpy:1242
translate luxembourgish ending_hidden_ef2bf190:

    # "Der Wald verstummt. Der Ort wird normal. Aber etwas fehlt."
    "De Bësch verstummt. Den Ort gëtt normal. Awer eppes feelt."

# game/renpy_scheuerhof.rpy:1244
translate luxembourgish ending_hidden_a52da6dd:

    # "Lina spürt eine Leere. Als hätte sie einen Teil von sich selbst geopfert."
    "D'Lina spiert eng Läiselechkeet. Wéi hätt si en Deel vu sech selwer opgeoffert."

# game/renpy_scheuerhof.rpy:1246
translate luxembourgish ending_hidden_788fecb3:

    # "Manchmal ist das Ende eines Fluchs der Beginn einer Leere."
    "Heiansdo ass d'Enn vun engem Fluch den Ufank vun enger Läiselechkeet."

# game/renpy_scheuerhof.rpy:1258
translate luxembourgish glossar_0cbc229d:

    # "GLOSSAR — BEGRIFFE UND HINTERGRÜNDE"
    "GLOSSAR — BEGRIFFER AN HANNERGRËNN"

# game/renpy_scheuerhof.rpy:1261
translate luxembourgish glossar_dd925f3e:

    # "Scheuerhof: historischer Ort im Wald, genutzt als Siedlung, Kloster, Bauernhof, Gasthaus, Erholungsheim, Sanatorium, Pockenstation."
    "Scheuerhof: historeschen Ort am Bësch, genotzt als Siidlung, Klouschter, Bauerenhaff, Gasthaus, Erholungsheem, Sanatorium, Pockenstatioun."

# game/renpy_scheuerhof.rpy:1262
translate luxembourgish glossar_474361bb:

    # "Hüter: gebundene Erinnerung des Ortes, entstanden aus Pater Amandus Dreisbach."
    "Hüter: gebonnen Erënnerung vum Ort, entstan aus dem Pater Amandus Dreisbach."

# game/renpy_scheuerhof.rpy:1263
translate luxembourgish glossar_25098c4d:

    # "Familie Grundiss: bewirtschaftete den Hof im 19. Jahrhundert. Sohn Reimar Grundiss wurde später Oberstleutnant."
    "Famill Grundiss: huet den Haff am 19. Joerhonnert bewirtschaft. De Jong Reimar Grundiss ass spéider Oberstleutnant ginn."

# game/renpy_scheuerhof.rpy:1264
translate luxembourgish glossar_9628ce45:

    # "Gasthaus zur Sommerfrische: ab 1909 betriebenes Erholungsgasthaus mit Park, Voliere und Tiergehege."
    "Gasthaus zur Sommerfrische: vun 1909 un betribene Erholungsgasthaus mat Park, Volière an Déierengehei."

# game/renpy_scheuerhof.rpy:1265
translate luxembourgish glossar_8a25c48a:

    # "Erholungsheim der Kreissparkasse Saarbrücken: ab 1950 genutzt als Erholungsheim für Angestellte, ab 1955 zum Lungensanatorium umgebaut."
    "Erholungsheem vun der Kreissparkasse Saarbrécken: vun 1950 un genotzt als Erholungsheem fir Ugestallten, vun 1955 un zum Lungensanatorium ëmgebaut."

# game/renpy_scheuerhof.rpy:1266
translate luxembourgish glossar_6d117cdc:

    # "Pockenstation: 1970 errichteter, isolierter Betonbau zur Behandlung von Pockenfällen - wurde nie in Betrieb genommen, heute Ruine im Wald."
    "Pockenstatioun: 1970 gebauten, isoléierten Betonbau fir d'Behandlung vu Pockefäll - gouf ni a Betrib geholl, haut Ruin am Bësch."

# game/renpy_scheuerhof.rpy:1267
translate luxembourgish glossar_1dd5c31c:

    # "Pfad der Stille: Weg zwischen Nohn und Dreisbach, aufgeladen mit Geschichte und Ritualen."
    "Wee vun der Rou: Wee tëscht Nohn a Dreisbach, gelueden mat Geschicht a Ritualer."

translate luxembourgish strings:

    # game/renpy_scheuerhof.rpy:233
    old "Wie reagiert Lina?"
    new "Wéi reagéiert d'Lina?"

    # game/renpy_scheuerhof.rpy:236
    old "Sie vertraut ihrem Gefühl."
    new "Si vertraut hirem Gefill."

    # game/renpy_scheuerhof.rpy:240
    old "Sie spielt es runter."
    new "Si spillt et erof."

    # game/renpy_scheuerhof.rpy:248
    old "Erzählt Kai mehr über seinen Opa?"
    new "Erzielt de Kai méi iwwer säi Bopa?"

    # game/renpy_scheuerhof.rpy:251
    old "Ja, er öffnet sich."
    new "Jo, hie mécht sech op."

    # game/renpy_scheuerhof.rpy:255
    old "Nein, er bleibt vage."
    new "Nee, hie bleift vague."

    # game/renpy_scheuerhof.rpy:313
    old "Linas innerer Monolog"
    new "D'Lina hire banneschte Monolog"

    # game/renpy_scheuerhof.rpy:316
    old "Sie hört hin."
    new "Si lauschtert no."

    # game/renpy_scheuerhof.rpy:321
    old "Sie verdrängt es."
    new "Si verdrängt et."

    # game/renpy_scheuerhof.rpy:405
    old "Wie reagiert Kai?"
    new "Wéi reagéiert de Kai?"

    # game/renpy_scheuerhof.rpy:408
    old "Er macht einen Witz."
    new "Hie mécht e Witz."

    # game/renpy_scheuerhof.rpy:411
    old "Er nimmt es ernst."
    new "Hie hëlt et eescht."

    # game/renpy_scheuerhof.rpy:420
    old "Mira erinnert sich an ihre Oma?"
    new "Erënnert sech d'Mira un hir Bomi?"

    # game/renpy_scheuerhof.rpy:423
    old "Ja, sie erzählt."
    new "Jo, si erzielt."

    # game/renpy_scheuerhof.rpy:427
    old "Nein, sie schweigt."
    new "Nee, si schweigt."

    # game/renpy_scheuerhof.rpy:495
    old "Sie stellt sich ihm."
    new "Si stellt sech him."

    # game/renpy_scheuerhof.rpy:500
    old "Sie schweigt."
    new "Si schweigt."

    # game/renpy_scheuerhof.rpy:526
    old "Wie reagieren die drei?"
    new "Wéi reagéieren déi dräi?"

    # game/renpy_scheuerhof.rpy:529
    old "Sie hören zu."
    new "Si lauschteren zou."

    # game/renpy_scheuerhof.rpy:535
    old "Sie lehnen es ab."
    new "Si leenen et of."

    # game/renpy_scheuerhof.rpy:567
    old "Konfrontieren sie den Hüter?"
    new "Konfrontéieren si den Hüter?"

    # game/renpy_scheuerhof.rpy:570
    old "Ja, Lina stellt sich ihm."
    new "Jo, d'Lina stellt sech him."

    # game/renpy_scheuerhof.rpy:575
    old "Nein, sie weichen zurück."
    new "Nee, si wäichen zréck."

    # game/renpy_scheuerhof.rpy:603
    old "Wie reagiert Mira?"
    new "Wéi reagéiert d'Mira?"

    # game/renpy_scheuerhof.rpy:606
    old "Sie will alles dokumentieren."
    new "Si wëll alles dokumentéieren."

    # game/renpy_scheuerhof.rpy:612
    old "Sie hat Angst vor den Bildern."
    new "Si huet Angscht virun de Biller."

    # game/renpy_scheuerhof.rpy:654
    old "Wer hebt das Buch auf?"
    new "Wien hieft d'Buch op?"

    # game/renpy_scheuerhof.rpy:657
    old "Lina."
    new "Lina."

    # game/renpy_scheuerhof.rpy:662
    old "Kai."
    new "Kai."

    # game/renpy_scheuerhof.rpy:667
    old "Mira."
    new "Mira."

    # game/renpy_scheuerhof.rpy:778
    old "Wer nähert sich dem Brunnen?"
    new "Wien nähert sech dem Brunnen?"

    # game/renpy_scheuerhof.rpy:944
    old "Wie reagiert Lina auf diese ruhige Seite des Hüters?"
    new "Wéi reagéiert d'Lina op dës roueg Säit vum Hüter?"

    # game/renpy_scheuerhof.rpy:947
    old "Sie ist erleichtert."
    new "Si ass erliichtert."

    # game/renpy_scheuerhof.rpy:952
    old "Sie bleibt misstrauisch."
    new "Si bleift méisstrauesch."

    # game/renpy_scheuerhof.rpy:992
    old "Was fragt Mira?"
    new "Wat freet d'Mira?"

    # game/renpy_scheuerhof.rpy:995
    old "Warum ist das vorbei?"
    new "Firwat ass dat eriwwer?"

    # game/renpy_scheuerhof.rpy:999
    old "Hast du ihnen geholfen?"
    new "Hues du hinnen gehollef?"

    # game/renpy_scheuerhof.rpy:1069
    old "Hast du das getan?"
    new "Hues du dat gemaach?"

    # game/renpy_scheuerhof.rpy:1073
    old "Vielleicht war es einfach Pech."
    new "Vläicht war et einfach Päch."

    # game/renpy_scheuerhof.rpy:1119
    old "Sie versprechen, ihn zu erinnern."
    new "Si verspriechen, sech un hie z'erënneren."

    # game/renpy_scheuerhof.rpy:1125
    old "Sie schweigen."
    new "Si schweigen."

    # game/renpy_scheuerhof.rpy:1148
    old "Was tun sie?"
    new "Wat maachen si?"

    # game/renpy_scheuerhof.rpy:1151
    old "Schweigen — den Ort vergessen lassen."
    new "Schweigen — den Ort vergiesse loossen."

    # game/renpy_scheuerhof.rpy:1154
    old "Veröffentlichen — die Welt soll es wissen."
    new "Verëffentlechen — d'Welt soll et wëssen."

    # game/renpy_scheuerhof.rpy:1157
    old "Bewahren — die Geschichte schützen, den Ort schützen."
    new "Bewahren — d'Geschicht schützen, den Ort schützen."

    # game/renpy_scheuerhof.rpy:1160
    old "Verraten — Lina vergisst seinen Namen absichtlich."
    new "Verroden — d'Lina vergësst säi Numm absichtlech."

# game/renpy_scheuerhof.rpy:931
translate luxembourgish sakularisation_39a765db:

    # "Fast dreißig Jahre sind vergangen. Die Kutten sind verblasst. Der Altar ist nur noch ein Steinhaufen mit Erinnerung."
    "Bal dräisseg Joer sinn vergaangen. D'Kutten si verbleecht. Den Altor ass nëmmen nach en Haufen Steng mat enger Erënnerung."

# game/renpy_scheuerhof.rpy:933
translate luxembourgish sakularisation_da821f21:

    # h "1802. Napoleons Verwaltung kommt. Sie nennen es Säkularisation."
    h "1802. Napoleons Verwaltung kënnt. Si nennen et Säkularisatioun."

# game/renpy_scheuerhof.rpy:935
translate luxembourgish sakularisation_ff40e0d6:

    # "Männer in fremden Uniformen vermessen das Land. Sie sprechen eine Sprache, die der Wald nicht kennt."
    "Männer a friemen Uniformen vermiessen d'Land. Si schwätzen eng Sprooch, déi de Bësch net kennt."

# game/renpy_scheuerhof.rpy:938
translate luxembourgish sakularisation_38291a79:

    # k "Aber... die Jesuiten waren doch schon 1773 weg."
    k "Awer... d'Jesuiten waren dach schonn 1773 fort."

# game/renpy_scheuerhof.rpy:939
translate luxembourgish sakularisation_a44cd9e2:

    # h "Die Jesuiten, ja. Aber die Kirche hatte das Land noch. Ein paar Brüder vom Bistum. Genug, dass hier noch gebetet wurde."
    h "D'Jesuiten, jo. Awer d'Kierch hat d'Land nach. E puer Bridder vum Bistum. Genuch, dass hei nach gebiet gouf."

# game/renpy_scheuerhof.rpy:941
translate luxembourgish sakularisation_adb110fb:

    # "Ein Offizier liest ein Dekret vor. Niemand hier versteht jedes Wort. Aber alle verstehen die Bedeutung."
    "En Offizéier liest en Dekret vir. Keen hei versteet all Wuert. Awer jiddereen versteet d'Bedeitung."

# game/renpy_scheuerhof.rpy:943
translate luxembourgish sakularisation_c8a3a187:

    # h "Sie haben den letzten geweihten Stein genommen. Danach war ich nicht mehr Diener einer Kirche. Nur noch... übrig."
    h "Si hunn de leschte gewitte Steen geholl. Duerno war ech net méi Déngscht vun enger Kierch. Nëmme méi... iwwreg."

# game/renpy_scheuerhof.rpy:950
translate luxembourgish sakularisation_e4e63f3e:

    # m "Das erklärt, warum die Kapelle nie wieder aufgebaut wurde."
    m "Dat erklärt, firwat d'Kapell ni méi opgebaut gouf."

# game/renpy_scheuerhof.rpy:951
translate luxembourgish sakularisation_02f36569:

    # h "Niemand baut etwas wieder auf, das dem Staat gehört. Es wurde verkauft. Wie Ackerland."
    h "Keen baut eppes nees op, wat dem Staat gehéiert. Et gouf verkaaft. Wéi Akerland."

# game/renpy_scheuerhof.rpy:955
translate luxembourgish sakularisation_1a9eb530:

    # m "Wer hat das Land dann bekommen?"
    m "Wien huet dann d'Land kritt?"

# game/renpy_scheuerhof.rpy:956
translate luxembourgish sakularisation_05a9a53e:

    # h "Bauern. Menschen, die nicht wussten, was sie gekauft hatten. Nur, dass es billig war."
    h "Bauere. Mënschen, déi net wossten, wat si kaaft haten. Nëmmen, dass et bëlleg war."

# game/renpy_scheuerhof.rpy:958
translate luxembourgish sakularisation_5af82427:

    # "Der Wald schluckt die letzten lateinischen Worte. Was bleibt, ist nur noch Erde."
    "De Bësch schléckt déi lescht laténgesch Wierder. Wat bleift, ass nëmmen Äerd."

# game/renpy_scheuerhof.rpy:1303
translate luxembourgish glossar_291eccfb:

    # "Jesuiten: katholischer Orden, bekannt für Bildung, Seelsorge und Missionsarbeit. Der Orden wurde 1773 päpstlich aufgelöst."
    "Jesuiten: kathoulesche Uerden, bekannt fir Bildung, Séilsuerch a Missiounsaarbecht. Den Uerden gouf 1773 päpstlech opgeléist."

# game/renpy_scheuerhof.rpy:1304
translate luxembourgish glossar_6570d779:

    # "Säkularisation: 1802 unter napoleonischer Verwaltung eingezogenes und verkauftes Kirchenland - endgültiges Ende jeder religiösen Nutzung des Scheuerhofs."
    "Säkularisatioun: 1802 ënnert napoleonescher Verwaltung agezunn a verkaaft Kierchland - endgülteg Enn vun all reliéiser Notzung vum Scheuerhof."

translate luxembourgish strings:

    # game/renpy_scheuerhof.rpy:948
    old "Das erklärt, warum die Kapelle nie wieder aufgebaut wurde."
    new "Dat erklärt, firwat d'Kapell ni méi opgebaut gouf."

    # game/renpy_scheuerhof.rpy:952
    old "Wer hat das Land dann bekommen?"
    new "Wien huet dann d'Land kritt?"

# renpy_scheuerhof.rpy:198
translate luxembourgish start_682c11a5:

    # m "Halt still, Kai, ich will dich mit der Kamera einfangen, bevor's dunkel und unscharf wird."
    m "Bleif roueg, Kai, ech well dech mat der Kamera festhalen, ier et donkel a onscharf gëtt."

# renpy_scheuerhof.rpy:711
translate luxembourgish jesuiten_block_1_cfcb8870:

    # "Ein weiteres Buch fällt aus dem Regal. Es öffnet sich selbst, als würde es atmen."
    "En weidert Buch fält aus dem Regal. Et geet vu selwer op, wéi wann et otemt."

# renpy_scheuerhof.rpy:713
translate luxembourgish jesuiten_block_1_a26b14c8:

    # h "Die Jesuiten kamen nicht als Eroberer. Sie kamen als Heiler."
    h "D'Jesuiten koumen net als Eruewerer. Si koumen als Heeler."

# renpy_scheuerhof.rpy:714
translate luxembourgish jesuiten_block_1_132e8e77:

    # h "Sie errichteten eine Kapelle, einen Garten und einen Brunnen, der nie versiegte."
    h "Si hunn eng Kapell, e Gaart an e Brunnen gebaut, dee ni ausgedréchent ass."

# renpy_scheuerhof.rpy:716
translate luxembourgish jesuiten_block_1_05e3473d:

    # h "Sie bemerkten Lichter im Wald. Stimmen, die nicht menschlich waren."
    h "Si hu Luuchten am Bësch bemierkt. Stëmmen, déi net mënschlech waren."

# renpy_scheuerhof.rpy:717
translate luxembourgish jesuiten_block_1_cb81c2e6:

    # h "Mehrere Mönche träumten denselben Traum — von einer Siedlung, die längst verschwunden war."
    h "Verschidde Mönche hunn deen selwechte Dram gedreemt — vun enger Siidlung, déi längst verschwonnen war."

# renpy_scheuerhof.rpy:719
translate luxembourgish jesuiten_block_1_a7d27701:

    # h "Sie schrieben: 'Dieser Ort hat einen Willen.'"
    h "Si hunn geschriwwen: 'Dëse Ort huet e Wëlle.'"

# renpy_scheuerhof.rpy:722
translate luxembourgish jesuiten_block_1_03e54cc6:

    # m "Aber die Jesuiten waren doch nicht die Ersten hier."
    m "Awer d'Jesuiten waren dach net déi Éischt hei."

# renpy_scheuerhof.rpy:723
translate luxembourgish jesuiten_block_1_8d738cc0:

    # h "Nein. Vor uns war ein Mann namens Bockenheim. Er hat diesen Hof erst gebaut - 1629, auf brachliegendem Land, das man Scheuren nannte."
    h "Nee. Virun eis war e Mann mam Numm Bockenheim. Hien huet dëse Haff als éischte gebaut - 1629, op Broochland, dat een Scheuren genannt huet."

# renpy_scheuerhof.rpy:725
translate luxembourgish jesuiten_block_1_f2069508:

    # h "Ein Dorf war das einmal. Aber es war schon tot, lange bevor er kam."
    h "Dat war eemol en Duerf. Awer et war schonn dout, laang ier hie koum."

# renpy_scheuerhof.rpy:728
translate luxembourgish jesuiten_block_1_5bc1ac5b:

    # k "Und davor?"
    k "An dovirdrun?"

# renpy_scheuerhof.rpy:729
translate luxembourgish jesuiten_block_1_9dc09d9a:

    # h "Davor war es römisch. Ein Speicher, ein 'Horreum', sagten sie. Daher der Name - Scheuern, Scheuerhof. Getreide, Heu, Proviant. Immer schon ein Ort, an dem man etwas aufbewahrte."
    h "Dovirdrun war et réimesch. E Späicher, en 'Horreum', hu si gesot. Doduerch de Numm - Scheuren, Scheuerhof. Getreid, Hee a Proviant. Ëmmer schonn en Ort, wou een eppes opbewaart huet."

# renpy_scheuerhof.rpy:731
translate luxembourgish jesuiten_block_1_e091ad80:

    # h "Auch der Name trug das weiter. Ein Heisso von Horreum saß hier im zwölften Jahrhundert. Später ein Pfarrer, Johannes de Horreo. Der Ort hat seinen lateinischen Namen nie ganz losgelassen."
    h "Och den Numm huet dat weidergedroen. E Heisso vun Horreum huet hei am zwieleften Joerhonnert gewunnt. Méi spéit e Paschtouer, den Johannes de Horreo. Den Ort huet säin laténgeschen Numm ni ganz lassgelooss."

# renpy_scheuerhof.rpy:733
translate luxembourgish jesuiten_block_1_f919c141:

    # h "1643 kaufte uns Bockenheims Witwe den Hof ab. Zweitausend Reichstaler und zwei Fuder Wein."
    h "1643 huet d'Wittfra vum Bockenheim eis de Haff ofkaaft. Zweedausend Reichstaler an zwee Fuder Wäin."

# renpy_scheuerhof.rpy:785
translate luxembourgish siedlung_cf18a9d3:

    # "Die Welt verändert sich. Der Wald wird heller, aber nicht freundlicher."
    "D'Welt ännert sech. De Bësch gëtt méi hell, awer net méi frëndlech."

# renpy_scheuerhof.rpy:787
translate luxembourgish siedlung_7b20451e:

    # "Sie stehen in einer Siedlung, die seit Jahrhunderten nicht mehr existiert."
    "Si stinn an enger Siidlung, déi zënter Joerhonnerte net méi existéiert."

# renpy_scheuerhof.rpy:789
translate luxembourgish siedlung_8b37c76d:

    # "Häuser aus Holz und Stein. Menschen, die sich bewegen, aber nicht sprechen. Als wären sie Erinnerungen, keine Lebenden."
    "Haiser aus Holz a Steen. Mënschen, déi sech beweegen, awer net schwätzen. Wéi wa se Erënnerunge wieren, keng Lieweg."

# renpy_scheuerhof.rpy:791
translate luxembourgish siedlung_2cddb715:

    # m "Das ist… das muss der alte Scheuerhof sein. Vor dem Kloster. Vor allem."
    m "Dat ass… dat muss den alen Scheuerhof sinn. Virum Klouschter. Virun allem."

# renpy_scheuerhof.rpy:793
translate luxembourgish siedlung_9dd98652:

    # h "Scheuren. So hieß dieser Ort, bevor er einen Hof trug. Ein eigenes Dorf, mit eigenem Bann."
    h "Scheuren. Sou huet dësen Ort geheescht, ier hie en Haff gedroen huet. E richtegt Duerf, mat sengem eegene Bann."

# renpy_scheuerhof.rpy:796
translate luxembourgish siedlung_fb4900b6:

    # k "Was ist aus ihm geworden?"
    k "Wat ass doraus ginn?"

# renpy_scheuerhof.rpy:797
translate luxembourgish siedlung_5e99e350:

    # h "Nichts Dramatisches. Kein Feuer, kein Krieg. Es ist einfach... verschwunden. Als die Herzöge hundert Jahre später ihre Steuerlisten zählten, stand Scheuren nicht mehr darauf. Niemand hat aufgeschrieben, warum."
    h "Näischt Dramateschent. Kee Feier, keen Krich. Et ass einfach... verschwonnen. Wéi d'Herzogen honnert Joer méi spéit hir Steierlëschte gezielt hunn, stoung Scheuren net méi drop. Keen huet opgeschriwwen, firwat."

# renpy_scheuerhof.rpy:799
translate luxembourgish siedlung_c357a903:

    # "Ein Kind bleibt stehen. Es sieht Lina an. Seine Augen sind schwarz wie Tinte."
    "E Kand bleift stoen. Et kuckt d'Lina un. Seng Aen si schwaarz wéi Tinte."

# renpy_scheuerhof.rpy:802
translate luxembourgish siedlung_f21f212c:

    # l "Es… es kennt mich."
    l "Et… et kennt mech."

# renpy_scheuerhof.rpy:803
translate luxembourgish siedlung_c11237ca:

    # k "Das ist unmöglich."
    k "Dat ass onméiglech."

# renpy_scheuerhof.rpy:805
translate luxembourgish siedlung_fa9694b9:

    # h "Erinnerungen kennen jeden, der sie berührt."
    h "Erënnerunge kenne jiddereen, deen se beréiert."

# renpy_scheuerhof.rpy:807
translate luxembourgish siedlung_56422e3c:

    # "Das Kind hebt die Hand. Es zeigt auf den Brunnen."
    "D'Kand hieft d'Hand. Et weist op de Brunnen."

# renpy_scheuerhof.rpy:817
translate luxembourgish siedlung_6df075b2:

    # "Der Brunnen enthält kein Wasser. Er enthält Licht. Flüssiges Licht."
    "De Brunnen huet kee Waasser. Hie huet Luucht. Flësseg Luucht."

# renpy_scheuerhof.rpy:820
translate luxembourgish siedlung_db0bfd99:

    # m "Das ist nicht natürlich."
    m "Dat ass net natierlech."

# renpy_scheuerhof.rpy:821
translate luxembourgish siedlung_7d8efa56:

    # h "Das ist der Ursprung. Der Ort war nie normal. Er war immer wach."
    h "Dat ass den Urspronk. Den Ort war ni normal. Hie war ëmmer wakereg."

# renpy_scheuerhof.rpy:829
translate luxembourgish siedlung_a8d4e684:

    # l "Ich… ich fühle etwas. Als würde mich jemand rufen."
    l "Ech… ech spieren eppes. Wéi wann een mech géif ruffen."

# renpy_scheuerhof.rpy:833
translate luxembourgish siedlung_f8c5af2a:

    # k "Wenn das hier echt ist, müssen wir wissen, was es bedeutet."
    k "Wann dat hei echt ass, mussen mir wëssen, wat et bedeit."

# renpy_scheuerhof.rpy:837
translate luxembourgish siedlung_95144fd7:

    # m "Ich muss das festhalten. Es ist wichtig."
    m "Ech muss dat festhalen. Et ass wichteg."

# renpy_scheuerhof.rpy:839
translate luxembourgish siedlung_31f841b6:

    # "Das Licht pulsiert. Der Brunnen beginnt zu flüstern."
    "D'Luucht pulséiert. De Brunnen fänkt un ze flüsteren."

# renpy_scheuerhof.rpy:841
translate luxembourgish siedlung_1af2ed7e:

    # h "Vergessen hat diese Siedlung getötet. Nicht Krieg. Nicht Krankheit. Vergessen."
    h "D'Vergiessen huet dës Siidlung ëmbruecht. Net de Krich. Net d'Krankheet. D'Vergiessen."

# renpy_scheuerhof.rpy:1030
translate luxembourgish hofakte_1905_ab1b6275:

    # "Fast ein Jahrhundert vergeht in wenigen Atemzügen. Pächter kommen, Pächter gehen. Namen, die niemand mehr kennt."
    "Bal en Joerhonnert vergeet a wéinegen Otemzich. Paachter kommen, Paachter goen. Nimm, déi keen méi kennt."

# renpy_scheuerhof.rpy:1032
translate luxembourgish hofakte_1905_6bfd7a49:

    # h "Nach der Säkularisation ersteigerte ein Herr Dysing das Land. Seine Tochter heiratete nach Metz. Die Familie de Musiel besaß den Hof über hundert Jahre, ohne je hier zu leben. Nur zur Jagd kamen sie. Sonst verwaltete ihn eine Familie für sie."
    h "No der Säkularisatioun huet en Här Dysing d'Land ersteigert. Seng Duechter huet no Metz bestuet. D'Famill de Musiel huet den Haff iwwer honnert Joer besiess, ouni jeemools hei ze wunnen. Nëmme fir ze jagen sinn si komm. Soss huet eng Famill en fir si verwalt."

# renpy_scheuerhof.rpy:1034
translate luxembourgish hofakte_1905_4044e27f:

    # "1904. Ein Feuer frisst sich durch die Wirtschaftsgebäude. Rauch steht tagelang über dem Tal."
    "1904. E Feier friesst sech duerch d'Wirtschaftsgebaier. Damp steet deelaang iwwert dem Dall."

# renpy_scheuerhof.rpy:1037
translate luxembourgish hofakte_1905_b1b4d4b3:

    # m "Ein Brand?"
    m "E Brand?"

# renpy_scheuerhof.rpy:1038
translate luxembourgish hofakte_1905_86a4b3be:

    # h "Die Scheunen, die Ställe - alles Asche. Was blieb, war eine Schuld, die niemand zahlen konnte."
    h "D'Scheiere, d'Ställ - alles Äsch. Wat bliwwen ass, war eng Schold, déi keen bezuele konnt."

# renpy_scheuerhof.rpy:1041
translate luxembourgish hofakte_1905_388042b8:

    # "Ein vergilbtes Zeitungsblatt schwebt zwischen den Jahren."
    "E vergilte Zeitungsblat schwieft tëscht de Joren."

# renpy_scheuerhof.rpy:1043
translate luxembourgish hofakte_1905_0f49997d:

    # "»Versteigerung des Hofgutes Scheuerhof.«"
    "»Verstéigerung vum Hafgut Scheuerhof.«"

# renpy_scheuerhof.rpy:1045
translate luxembourgish hofakte_1905_153eb34f:

    # "»Am Mittwoch, den 7. Juni 1905, vormittags 11 Uhr, werden die sämtlichen, zur Zeit noch zum Hofgut Scheuerhof gehörenden Ländereien — Äcker, Wiesen und Wälder auf den Bännen von Nohn, Wehingen, Bethingen und Tünsdorf — nebst sämtlichen Gebäulichkeiten, bestehend aus großem Wohnhaus, Scheunen, Stallungen und Bering, in der Wirtschaft der Witwe Hoffmann zu Wehingen öffentlich gegen ausgedehnten Zahlungsrückstand versteigert.«"
    "»Um Mëttwoch, de 7. Juni 1905, moies ëm 11 Auer, ginn all d'Ländereien, déi de Moment nach zum Hafgut Scheuerhof gehéieren — Äcker, Wisen a Bëscher op de Bäneren vun Nohn, Wehingen, Bethingen an Tünsdorf — zesumme mat allen Gebailechkeeten, dorënner e groust Wunnhaus, Scheieren, Ställ a Bering, an der Wirtschaft vun der Wittfra Hoffmann zu Wehingen ëffentlech géint e grousse Bezuelungsréckstand verstéigert.«"

# renpy_scheuerhof.rpy:1047
translate luxembourgish hofakte_1905_3ff4f25d:

    # "»Wegen Besichtigung wende man sich an Herrn Nikolaus Reiffers in Wehingen. Nähere Auskunft erteilt Herr Heinrich Rausch in Diedenhofen.«"
    "»Fir eng Besichtegung mellt Iech beim Här Nikolaus Reiffers zu Wehingen. Méi genau Auskunft gëtt den Här Heinrich Rausch zu Diedenhofen.«"

# renpy_scheuerhof.rpy:1049
translate luxembourgish hofakte_1905_e3a39b7f:

    # "»Perl a.d. Mosel, den 29. Mai 1905. Der Königliche Notar, Franz Duren.«"
    "»Perl a.d. Musel, de 29. Mee 1905. De Kinneklechen Notar, Franz Duren.«"

# renpy_scheuerhof.rpy:1052
translate luxembourgish hofakte_1905_d53de6a2:

    # m "Das ist… eine echte Versteigerungsakte. Kein Sanatorium. Kein Kloster. Nur ein Hof, der abbrennt und verkauft wird."
    m "Dat ass… eng richteg Verstéigerungsakt. Kee Sanatorium. Kee Klouschter. Just en Haff, deen ofbrennt a verkaaft gëtt."

# renpy_scheuerhof.rpy:1055
translate luxembourgish hofakte_1905_9add5749:

    # l "So fängt es also an. Nicht mit einem Fluch. Mit einem Feuer und einer unbezahlten Rechnung."
    l "Sou fänkt et also un. Net mat engem Fluch. Mat engem Feier an enger onbezuelter Rechnung."

# renpy_scheuerhof.rpy:1057
translate luxembourgish hofakte_1905_3474a98d:

    # h "Manchmal ist das dasselbe."
    h "Heiansdo ass dat dat selwecht."

# renpy_scheuerhof.rpy:1059
translate luxembourgish hofakte_1905_b03a42d9:

    # "Erst vier Jahre später, 1909, findet sich endlich ein Käufer, der bleibt."
    "Eréischt véier Joer méi spéit, 1909, fënnt sech endlech en Keefer, deen bleift."

# renpy_scheuerhof.rpy:1061
translate luxembourgish hofakte_1905_2be844f0:

    # "Das Zeitungsblatt löst sich auf wie Rauch. Die Jahreszahlen springen weiter."
    "D'Zeitungsblat léist sech op wéi Damp. D'Joreszuelen sprangen weider."

# renpy_scheuerhof.rpy:1078
translate luxembourgish gasthaus_sommerfrische_cb26463f:

    # "1920. Der Hof ist verschwunden. An seiner Stelle: ein gepflegtes Gasthaus. Ein Garten. Eine Voliere voller Vögel."
    "1920. Den Haff ass verschwonnen. Un senger Plaz: e gepflegt Gasthaus. E Gaart. Eng Volière voller Vullen."

# renpy_scheuerhof.rpy:1080
translate luxembourgish gasthaus_sommerfrische_35810a4d:

    # h "Nikolaus Berens hat das Land 1909 ersteigert. Aber erst Jahre später macht seine Familie daraus, was ihr hier seht."
    h "Den Nikolaus Berens huet d'Land 1909 ersteigert. Awer eréischt Joren duerno mécht seng Famill doraus, wat der hei gesitt."

# renpy_scheuerhof.rpy:1082
translate luxembourgish gasthaus_sommerfrische_67c9ae3c:

    # h "Das war die schönste Zeit."
    h "Dat war déi schéinste Zäit."

# renpy_scheuerhof.rpy:1084
translate luxembourgish gasthaus_sommerfrische_9ed1bcf2:

    # m "Es sieht... friedlich aus."
    m "Et gesäit... friddlech aus."

# renpy_scheuerhof.rpy:1085
translate luxembourgish gasthaus_sommerfrische_f42c0a37:

    # h "Menschen kamen wegen der Stille. Nicht, um sie zu füllen. Nur, um in ihr zu sitzen."
    h "D'Mënsche koumen ewéinst der Rou. Net fir se ze fëllen. Just fir dran ze sëtzen."

# renpy_scheuerhof.rpy:1087
translate luxembourgish gasthaus_sommerfrische_be5eea12:

    # "Kinder füttern Rehe in einem kleinen Gehege. Ein Kellner trägt Kaffee über den Kiesweg. Irgendwo singt jemand."
    "Kanner fidderen Réier an engem klenge Gehee. E Kellner dréit Kaffi iwwer de Kieselwee. Iergendwou sengt een."

# renpy_scheuerhof.rpy:1090
translate luxembourgish gasthaus_sommerfrische_2cb5ae2c:

    # k "Und du warst... glücklich?"
    k "An du wars... glécklech?"

# renpy_scheuerhof.rpy:1091
translate luxembourgish gasthaus_sommerfrische_e827b3a5:

    # h "Ich weiß nicht, ob ich glücklich sein kann. Aber ich war nicht allein. Die Gäste kannten meinen Namen nicht. Aber sie haben den Ort geachtet."
    h "Ech weess net, ob ech glécklech kann sinn. Awer ech war net eleng. D'Gäscht hu mäin Numm net gekannt. Awer si hunn den Ort respektéiert."

# renpy_scheuerhof.rpy:1098
translate luxembourgish gasthaus_sommerfrische_889e895c:

    # m "Warum ist das vorbei?"
    m "Firwat ass dat eriwwer?"

# renpy_scheuerhof.rpy:1099
translate luxembourgish gasthaus_sommerfrische_3e023d3d:

    # h "Nichts Gutes bleibt, wenn niemand es festhält. Das habt ihr doch schon gelernt."
    h "Näischt Gutt bleift, wa keen et festhält. Dat hutt der dach schonn geléiert."

# renpy_scheuerhof.rpy:1103
translate luxembourgish gasthaus_sommerfrische_a8a3c941:

    # m "Hast du ihnen irgendwie geholfen?"
    m "Hues du hinnen iergendwéi gehollef?"

# renpy_scheuerhof.rpy:1104
translate luxembourgish gasthaus_sommerfrische_cc074d00:

    # h "Ein wenig. Der Brunnen war nie leer. Vielleicht war das kein Zufall."
    h "E bësse. De Brunnen war ni eidel. Vläicht war dat kee Zoufall."

# renpy_scheuerhof.rpy:1106
translate luxembourgish gasthaus_sommerfrische_b462b19d:

    # "Das Bild verblasst wie eine alte Fotografie, die zu lange in der Sonne lag."
    "D'Bild verbleecht wéi eng al Fotografie, déi ze laang an der Sonn louch."

# renpy_scheuerhof.rpy:1123
translate luxembourgish grundiss_hof_cf7b0ffc:

    # "1933. Das Gasthaus ist verschwunden. Stattdessen: ein Bauernhof. Hühner. Ein Pflug. Rauch aus einem Schornstein."
    "1933. D'Gasthaus ass verschwonnen. Amplaz: e Bauerenhaff. Hénger. E Plou. Damp aus engem Schornsteen."

# renpy_scheuerhof.rpy:1125
translate luxembourgish grundiss_hof_bea4db9d:

    # h "Berens hat verkauft. Die Gästezahlen wurden dünner, die Zeiten schlechter. Ein Diplom-Landwirt namens Grundiss übernahm - mit seiner Frau Martha."
    h "De Berens huet verkaaft. D'Gäscht sinn ëmmer manner ginn, d'Zäiten méi schlecht. En Diplom-Landwirt mam Numm Grundiss huet iwwerholl - mat senger Fra Martha."

# renpy_scheuerhof.rpy:1127
translate luxembourgish grundiss_hof_ae7e935a:

    # "Ein Mann führt ein Pferd über den Hof. Ein Junge läuft ihm hinterher, ein Holzgewehr in der Hand."
    "E Mann féiert e Päerd iwwer den Haff. E Jong leeft him hannendrun, e Holzgewier an der Hand."

# renpy_scheuerhof.rpy:1129
translate luxembourgish grundiss_hof_f5dfa5cc:

    # m "Wer sind die?"
    m "Wien sinn déi?"

# renpy_scheuerhof.rpy:1130
translate luxembourgish grundiss_hof_5189004c:

    # h "Die Familie Grundiss. Sie haben den Hof bestellt, ohne zu wissen, was unter ihm liegt."
    h "D'Famill Grundiss. Si hu den Haff bestallt, ouni ze wëssen, wat drënner läit."

# renpy_scheuerhof.rpy:1133
translate luxembourgish grundiss_hof_6ce9d2b1:

    # k "Und du? Was hast du gemacht?"
    k "An du? Wat hues du gemaach?"

# renpy_scheuerhof.rpy:1134
translate luxembourgish grundiss_hof_86424cf2:

    # h "Nichts. Zum ersten Mal seit Langem: nichts. Ich habe zugesehen, wie sie die Erde bestellt haben. Es hat sich... richtig angefühlt."
    h "Näischt. Fir d'éischte Kéier zënter Laangem: näischt. Ech hu gekuckt, wéi si d'Äerd bestallt hunn. Et huet sech... richteg ugefillt."

# renpy_scheuerhof.rpy:1136
translate luxembourgish grundiss_hof_474126f2:

    # "Grundiss wollte den Hof vergrößern, Land von den Wehinger Bauern dazukaufen. Ein neues Gesetz der Machthaber verbot es ihm."
    "De Grundiss wollt den Haff vergréisseren, Land vun de Wehinger Bauere bäikafen. En neit Gesetz vun de Machthaber huet him dat verbueden."

# renpy_scheuerhof.rpy:1144
translate luxembourgish grundiss_hof_a9f12bc2:

    # l "Dann bist du nicht nur... das, was wir in der Kapelle gesehen haben."
    l "Dann bass du net just... dat, wat mir an der Kapell gesinn hunn."

# renpy_scheuerhof.rpy:1145
translate luxembourgish grundiss_hof_3fa71a59:

    # h "Ich bin vieles. Aber am ruhigsten bin ich, wenn niemand versucht, mich zu besitzen oder zu erklären."
    h "Ech sinn vill Saachen. Awer am roulechsten sinn ech, wa keen probéiert, mech ze besëtzen oder z'erklären."

# renpy_scheuerhof.rpy:1148
translate luxembourgish grundiss_hof_2cc0964c:

    # l "Oder du hast einfach gewartet."
    l "Oder du hues just gewaart."

# renpy_scheuerhof.rpy:1149
translate luxembourgish grundiss_hof_4481a85a:

    # h "Vielleicht. Warten kann auch Frieden sein."
    h "Vläicht. Waarden kann och Fridden sinn."

# renpy_scheuerhof.rpy:1151
translate luxembourgish grundiss_hof_d94f5ecc:

    # "Krieg kommt über das Land. Der Junge wird älter. Man sieht ihn in Uniform, geht zur Tür hinaus. Der Hof bleibt zurück."
    "De Krich kënnt iwwert d'Land. De Jong gëtt eeler. Ee gesäit hie mat der Uniform un, wéi hie fort geet duerch d'Dier. Den Haff bleift zréck."

# renpy_scheuerhof.rpy:1154
translate luxembourgish grundiss_hof_9ff61830:

    # m "Wohin geht er?"
    m "Wouhi geet hie?"

# renpy_scheuerhof.rpy:1155
translate luxembourgish grundiss_hof_6fe4d23f:

    # h "Weg. Die meisten gehen irgendwann weg. Reimar Grundiss wurde Soldat. Er kam nie wirklich zurück."
    h "Fort. Déi meescht ginn iergendwann fort. De Reimar Grundiss ass Zaldot ginn. Hie koum ni richteg zréck."

# renpy_scheuerhof.rpy:1157
translate luxembourgish grundiss_hof_bdc1e299:

    # "Das Bild wird blasser. Die Jahreszahlen springen vorwärts."
    "D'Bild gëtt méi bleech. D'Joreszuelen sprangen no vir."

# renpy_scheuerhof.rpy:1208
translate luxembourgish investoren_verfall_68f82e78:

    # "1980. Das Sanatorium schließt. Die Geräte werden abtransportiert. Der Garten verwildert."
    "1980. D'Sanatorium mécht zou. D'Geräter ginn ofgeholl. De Gaart verwildert."

# renpy_scheuerhof.rpy:1210
translate luxembourgish investoren_verfall_422ce22a:

    # "1986. Das Land bietet den Komplex zum Kauf an - 8,3 Millionen Mark. Eine Pflegegesellschaft will hier einen Bauernhof für psychisch Kranke einrichten. Ihr Angebot: eine Million. Der Deal platzt."
    "1986. D'Land bitt de Komplex zum Verkaf un - 8,3 Millioune Mark. Eng Fleegegesellschaft wëllt hei e Bauerenhaff fir psychesch Krank aériichten. Hiert Ugebot: eng Millioun. Den Deal plazt."

# renpy_scheuerhof.rpy:1212
translate luxembourgish investoren_verfall_7762db84:

    # h "Dann kamen die Pläne. Jahr für Jahr neue."
    h "Dunn koumen d'Pläng. Joer fir Joer nei."

# renpy_scheuerhof.rpy:1214
translate luxembourgish investoren_verfall_6c838613:

    # "1988. Ein Hotelkomplex mit Sport- und Erholungszentrum, 250 neue Arbeitsplätze versprochen. Der Gemeinderat diskutiert. Naturschützer protestieren. Am Ende: nichts. 'Der Flop des Jahres', schreibt die Zeitung."
    "1988. E Hotelkomplex mat Sport- an Erholungszentrum, 250 nei Aarbechtsplazen zougesot. De Gemengerot diskutéiert. Naturschützer protestéieren. Um Enn: näischt. 'De Flop vum Joer', schreift d'Zeitung."

# renpy_scheuerhof.rpy:1217
translate luxembourgish investoren_verfall_6783eb7d:

    # k "Und dann?"
    k "An dunn?"

# renpy_scheuerhof.rpy:1218
translate luxembourgish investoren_verfall_a8afd426:

    # h "1990. Gerüchte über ein Manager-Zentrum mit Golfplatz. Gleichzeitig Gerüchte über ein Asylbewerberheim. Beides verschwindet wieder, bevor es echt wird."
    h "1990. Geriichter iwwer e Manager-Zentrum mat Golfterrain. Zur selwechter Zäit Geriichter iwwer eng Asylbewerberheem. Béides verschwënnt erëm, ier et echt gëtt."

# renpy_scheuerhof.rpy:1220
translate luxembourgish investoren_verfall_7ff6f309:

    # "Ein rostiges Bauschild kippt im Wind. 'Ferienanlage Scheuerhof - Eröffnung demnächst' steht darauf. Demnächst war vor zwanzig Jahren."
    "E verrouschtent Bauschëld kippt am Wand. 'Ferienanlag Scheuerhof - Ouverture geschwënn' steet drop. Geschwënn war viru zwanzeg Joer."

# renpy_scheuerhof.rpy:1227
translate luxembourgish investoren_verfall_d4de864c:

    # m "Hast du das getan? Sie alle vertrieben?"
    m "Hues du dat gemaach? Si all verdriwwen?"

# renpy_scheuerhof.rpy:1228
translate luxembourgish investoren_verfall_52ac6309:

    # h "Ich habe niemanden vertrieben. Ich habe nur nie etwas gegeben, das sich verkaufen ließ. Das war offenbar genug."
    h "Ech hunn néimools een verdriwwen. Ech hu just ni eppes ginn, wat sech huet verkafe gelooss. Dat war anscheinend genuch."

# renpy_scheuerhof.rpy:1231
translate luxembourgish investoren_verfall_e848d90b:

    # m "Vielleicht war es einfach Pech. Nicht jedes Projekt scheitert wegen... dir."
    m "Vläicht war et einfach Päch. Net all Projet scheitert wéinst... der."

# renpy_scheuerhof.rpy:1232
translate luxembourgish investoren_verfall_1c6695ed:

    # h "Vielleicht. Aber ich habe aufgehört, mir das zu wünschen."
    h "Vläicht. Awer ech hunn opgehalen, mir dat ze wënschen."

# renpy_scheuerhof.rpy:1237
translate luxembourgish investoren_verfall_479b00f1:

    # "Niemand hier wollte je wissen, was der Ort war. Nur, was er werden könnte."
    "Keen hei wollt jeemools wëssen, wat den Ort war. Nëmmen, wat en ka ginn."

# renpy_scheuerhof.rpy:1239
translate luxembourgish investoren_verfall_2466a67d:

    # h "Und jetzt wollt ihr wissen, was er war. Das ist... neu."
    h "An elo wëllt der wëssen, wat en war. Dat ass... nei."

# renpy_scheuerhof.rpy:1347
translate luxembourgish ending_alternative_d6a662d4:

    # "ENDE — Die Wahrheit ans Licht"
    "ENN — D'Wourecht un d'Luucht"

# renpy_scheuerhof.rpy:1383
translate luxembourgish ending_true_9d9c3589:

    # "ENDE — Der Hüter ist nicht mehr allein"
    "ENN — Den Hüter ass net méi eleng"

# renpy_scheuerhof.rpy:1398
translate luxembourgish ending_bad_b656a8db:

    # "Ein moderner Jagd- und Freizeitpark am Rand des Waldes. Schießbahnen. Eine Wurftaubenanlage. Ein Hotel mit über hundert Zimmern."
    "E modernen Jagd- a Fräizäitpark um Rand vum Bësch. Schéissbunnen. Eng Wurftaube-Anlag. En Hotel mat iwwer honnert Zëmmeren."

# renpy_scheuerhof.rpy:1400
translate luxembourgish ending_bad_9303fb48:

    # "Die Waldkron Freizeit GmbH hat investiert - rund 22 Millionen Euro. Geschäftsführer Werner Kalscheuer nennt es einen 'Themenpark für Tourismus, Sport und Jagd'. 160 neue Arbeitsplätze, verspricht die Presse."
    "D'Waldkron Freizeit GmbH huet investéiert - ronn 22 Millioune Euro. Geschäftsführer Werner Kalscheuer nennt et en 'Themepark fir Tourismus, Sport a Jagd'. 160 nei Aarbechtsplazen, verspriecht d'Press."

# renpy_scheuerhof.rpy:1402
translate luxembourgish ending_bad_1b3f300b:

    # m "Wir hätten etwas tun sollen."
    m "Mir hätte solle eppes maachen."

# renpy_scheuerhof.rpy:1403
translate luxembourgish ending_bad_0f4b9d9b:

    # k "Wir haben nichts getan."
    k "Mir hu näischt gemaach."

# renpy_scheuerhof.rpy:1404
translate luxembourgish ending_bad_211b3edb:

    # l "Der Hüter ist allein. Und der Fluch wird sich einen neuen Weg suchen."
    l "Den Hüter ass eleng. An de Fluch wäert sech en neie Wee sichen."

# renpy_scheuerhof.rpy:1407
translate luxembourgish ending_bad_2bdd3abc:

    # "In der Nacht hört man wieder Schritte im Wald. Stimmen im Beton. Flüstern in den Mauern."
    "An der Nuecht héiert een erëm Schrëtt am Bësch. Stëmmen am Beton. Geflëschter an de Maueren."

# renpy_scheuerhof.rpy:1409
translate luxembourgish ending_bad_1da81872:

    # "Das ist kein Ende. Das ist ein Anfang."
    "Dat ass keen Enn. Dat ass en Ufank."

# renpy_scheuerhof.rpy:1419
translate luxembourgish ending_bad_fed804b5:

    # "ENDE — Ein neuer Anfang"
    "ENN — En neien Ufank"

# renpy_scheuerhof.rpy:1458
translate luxembourgish ending_hidden_77797223:

    # "ENDE — Der Verrat"
    "ENN — De Verrot"

