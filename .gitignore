# Ren'Py SDK (~350 MB, third-party download, not project source).
# Get it from https://www.renpy.org/latest.html - same version: 8.5.3
renpy-8.5.3-sdk/

# Compiled Ren'Py bytecode - regenerated automatically from .rpy sources.
*.rpyc
*.rpymc
game/cache/

# Player save data - local state, not source.
game/saves/

# Build output (zips/tar.bz2) - regenerate via the Ren'Py launcher's
# "Build & Distribute" or `renpy.sh launcher distribute <project>`.
scheuerhof-*-dists/
scheuerhof-*-dists.zip
scheuerhof-*-release/

# Runtime logs.
log.txt
errors.txt
game/log.txt

# Ren'Py-Dialogexport - Zwischenprodukt, jederzeit neu erzeugbar mit
#   renpy.sh . dialogue None
dialogue.tab
dialogue.txt

# Audio-generation tooling: keep the scripts, drop the Python venvs
# (~2 GB, includes a full torch install). Recreate with:
#   python3 -m venv tools/audiogen/.venv && pip install torch torchaudio transformers ...
# See tools/audiogen/*.py headers for exact package versions used.
tools/audiogen/.venv/
tools/audiogen/.venv-sfx/

# Sprachausgabe-Tooling: Skripte bleiben, venv und die heruntergeladenen
# Piper-Stimmmodelle (~200 MB) nicht. Modelle holt generate_voice.py bei
# Bedarf selbst nach.
tools/voicegen/.venv/
tools/voicegen/.voices/
tools/audiogen/__pycache__/
**/__pycache__/

# Unrelated project that happens to live alongside this one - see
# scheuerhof_valkyrie/ (copied out) for the actual working copy.
valkyrie-quest/

# OS cruft.
.DS_Store
